#!/bin/bash
# yoru-watch - what the daily systemd timer calls.
#
# It does not run the watch cycle itself; that is the agent's job. It only
# makes sure the agent is called under the right conditions, and says why when
# it cannot be. Everything it prints goes to the journal, and the journal is
# persistent thanks to K09.

set -uo pipefail
umask 027
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin

CONFIG_FILE=/etc/yoru/yoru.conf
AGENT_BIN=/opt/yoru/bin/yoru-agent
DATA_DIR=/var/lib/yoru
LOCK_FILE="$DATA_DIR/.watch.lock"
TIME_LIMIT=900

say()  { printf '%s\n' "$*"; }
fail() { printf '%s\n' "$*" >&2; exit "${2:-1}"; }

# Must run as yoru-agent. Running as root would make the whole sudoers
# restriction decorative.
[ "$(id -un)" = "yoru-agent" ] || \
  fail "berhenti: harus berjalan sebagai yoru-agent, bukan $(id -un)"

[ -r "$CONFIG_FILE" ] || fail "berhenti: $CONFIG_FILE tidak ada. Jalankan 'sudo bash install.sh'."

# Read as text, never sourced - a value containing $(...) would otherwise run
# in a process holding the tokens.
#
# Do not use -F= and then edit $1. Touching $1 makes awk rebuild $0 with
# spaces, and every "=" on that line disappears. It passes on a tidy file and
# breaks on one with spaces around the key.
config_get() {  # config_get <KEY>
  awk -v k="$1" '
    {
      line = $0; sub(/^[[:space:]]+/, "", line)
      if (line ~ /^#/ || line == "") next
      p = index(line, "="); if (p == 0) next
      key = substr(line, 1, p - 1); val = substr(line, p + 1)
      sub(/[[:space:]]+$/, "", key)
      sub(/^[[:space:]]+/, "", val); sub(/[[:space:]]+$/, "", val)
      gsub(/^"|"$/, "", val)
      if (key == k) { print val; exit }
    }' "$CONFIG_FILE"
}

SERVER_NAME="$(config_get NAMA_SERVER)"
SKIPPED="$(config_get LEWATI_KONTROL)"
[ -n "$SERVER_NAME" ] || SERVER_NAME="$(hostname)"

# No agent: exit FAILED, not success. A unit that finishes quietly every day
# while doing nothing is the kind of breakage that stays hidden longest. Let
# it show red in systemctl.
[ -x "$AGENT_BIN" ] || fail "berhenti: agent belum terpasang di $AGENT_BIN" 69

# Two cycles must not overlap. A fix cycle from the dashboard can land on top
# of the daily timer.
exec 9>"$LOCK_FILE" || fail "berhenti: tidak bisa membuat $LOCK_FILE"
flock -n 9 || { say "dilewati: siklus lain sedang berjalan"; exit 0; }

say "Siklus Penjagaan mulai - server=$SERVER_NAME"
[ -n "$SKIPPED" ] && say "dilewati atas permintaan pemilik: $SKIPPED"

started=$(date +%s)

# A timeout so a hung agent cannot hold the lock until tomorrow.
timeout --signal=TERM --kill-after=30s "$TIME_LIMIT" \
  "$AGENT_BIN" --siklus penjagaan --konfigurasi "$CONFIG_FILE"
code=$?
elapsed=$(( $(date +%s) - started ))

case "$code" in
  0)   say "selesai dalam ${elapsed}s" ;;
  124) say "GAGAL: agent lewat batas ${TIME_LIMIT}s, dihentikan paksa" >&2 ;;
  *)   say "GAGAL: agent berhenti dengan kode $code setelah ${elapsed}s" >&2 ;;
esac

exit "$code"
