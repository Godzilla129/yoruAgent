#!/bin/bash
# yoru-penjagaan - yang dipanggil timer systemd tiap hari.
#
# Tugasnya bukan mengerjakan Siklus Penjagaan itu sendiri - itu pekerjaan
# agent. Tugasnya memastikan agent dipanggil dalam keadaan yang benar, dan
# kalau tidak bisa, MENGATAKANNYA dengan jelas alih-alih diam.
#
# Semua keluaran masuk ke journal, dan journal itu permanen karena K09.
# Jadi kalau penjagaan berhenti jalan tiga minggu lalu, alasannya masih ada.

set -uo pipefail
umask 027
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin

KONF=/etc/yoru/yoru.conf
AGEN_BIN=/opt/yoru/bin/yoru-agent     # ini yang dipasang Lane 3
DIR_DATA=/var/lib/yoru
KUNCI="$DIR_DATA/.kunci-penjagaan"
BATAS_DETIK=900                        # 15 menit

kabar() { printf '%s\n'  "$*"; }
gagal() { printf '%s\n'  "$*" >&2; exit "${2:-1}"; }

# ------------------------------------------------------------ pemeriksaan
# Dijalankan sebagai yoru-agent, bukan root. Root tidak perlu di sini:
# satu-satunya yang butuh hak root adalah yoructl, dan itu lewat sudoers
# yang sudah dibatasi. Kalau skrip ini berjalan sebagai root, berarti ada
# yang salah pasang, dan diam-diam menerimanya berarti kita membuang
# seluruh pembatasan yang susah payah dibuat.
if [ "$(id -un)" != "yoru-agent" ]; then
  gagal "berhenti: harus berjalan sebagai yoru-agent, bukan $(id -un).
       Timer systemd sudah mengatur User=yoru-agent. Kalau pesan ini muncul,
       kemungkinan skrip dipanggil manual dengan sudo - jangan."
fi

[ -r "$KONF" ] || gagal "berhenti: $KONF tidak ada atau tidak bisa dibaca.
       Jalankan 'sudo bash install.sh' untuk membuatnya."

# Dibaca sebagai teks, BUKAN di-source. Nilai di berkas itu berisi kunci
# API; kalau di-source, nilai yang kebetulan mengandung \$(...) akan
# dijalankan oleh proses yang sedang memegang kunci itu.
#
# CATATAN untuk yang mengubah fungsi ini nanti: jangan memakai -F= lalu
# menyunting $1. Di awk, menyentuh $1 membuat $0 disusun ulang memakai OFS,
# dan semua tanda "=" di baris itu berubah jadi spasi - sehingga pencarian
# nilainya jadi kacau. Itu cuma terjadi pada baris yang punya spasi di
# sekitar nama kunci, jadi lolos di berkas contoh yang rapi dan baru
# ketahuan waktu diuji dengan berkas yang berantakan. Bekerja di atas
# salinan $0 seperti di bawah ini aman.
ambil() {  # ambil <KUNCI>
  awk -v k="$1" '
    {
      baris = $0
      sub(/^[[:space:]]+/, "", baris)
      if (baris ~ /^#/ || baris == "") next
      p = index(baris, "=")
      if (p == 0) next
      nama  = substr(baris, 1, p - 1)
      nilai = substr(baris, p + 1)
      sub(/[[:space:]]+$/, "", nama)
      sub(/^[[:space:]]+/, "", nilai); sub(/[[:space:]]+$/, "", nilai)
      gsub(/^"|"$/, "", nilai)
      if (nama == k) { print nilai; exit }
    }' "$KONF"
}

AI_API_KEY="$(ambil AI_API_KEY)"
AI_MODEL="$(ambil AI_MODEL)"
NAMA_SERVER="$(ambil NAMA_SERVER)"
LEWATI="$(ambil LEWATI_KONTROL)"
[ -n "$NAMA_SERVER" ] || NAMA_SERVER="$(hostname)"

# Kunci API kosong bukan hal yang bisa dilanjutkan diam-diam. Tanpa itu
# agent tidak bisa menimbang apa pun, dan penjagaan yang berjalan tanpa
# penimbangan cuma menghasilkan laporan kosong yang terlihat sehat.
[ -n "$AI_API_KEY" ] || gagal "berhenti: AI_API_KEY di $KONF masih kosong.
       Siklus Penjagaan tidak dijalankan. Isi dulu kuncinya."

# Agent belum terpasang: berhenti dengan status GAGAL, bukan sukses.
# Sengaja. Unit yang tiap hari selesai dengan tenang padahal tidak
# mengerjakan apa-apa adalah persis jenis kerusakan yang paling lama tidak
# ketahuan - dan itu yang kami buru sepanjang proyek ini. Biar terlihat
# merah di systemctl status.
[ -x "$AGEN_BIN" ] || gagal "berhenti: agent belum terpasang di $AGEN_BIN.
       Dispatcher dan katalog sudah siap, tapi belum ada yang memakainya.
       Ini bukan kerusakan - cuma pemasangan yang belum lengkap." 69

# ------------------------------------------------------------ jalankan
# flock supaya dua siklus tidak pernah berjalan bersamaan. Siklus Perbaikan
# yang dijalankan pemilik lewat dashboard bisa saja berbarengan dengan
# timer harian, dan dua proses yang menyentuh setelan yang sama pada saat
# yang sama adalah cara paling rapi untuk merusak server.
exec 9>"$KUNCI" || gagal "berhenti: tidak bisa membuat berkas kunci $KUNCI"
if ! flock -n 9; then
  kabar "dilewati: masih ada siklus lain yang berjalan. Ini normal, bukan galat."
  exit 0
fi

kabar "Siklus Penjagaan mulai - server=$NAMA_SERVER model=${AI_MODEL:-tidak-disetel}"
[ -n "$LEWATI" ] && kabar "kontrol yang dilewati atas permintaan pemilik: $LEWATI"

mulai=$(date +%s)

# timeout supaya agent yang menggantung tidak menahan kunci sampai besok.
timeout --signal=TERM --kill-after=30s "$BATAS_DETIK" \
  "$AGEN_BIN" --siklus penjagaan --konfigurasi "$KONF"
kode=$?

lama=$(( $(date +%s) - mulai ))

case "$kode" in
  0)   kabar "Siklus Penjagaan selesai dalam ${lama}s" ;;
  124) kabar "GAGAL: agent melewati batas ${BATAS_DETIK}s dan dihentikan paksa" >&2 ;;
  *)   kabar "GAGAL: agent berhenti dengan kode $kode setelah ${lama}s" >&2 ;;
esac

exit "$kode"
