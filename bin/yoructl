#!/bin/bash
# yoructl - Yoru's only door to root.
#
# Usage:  yoructl <K01..K10> <periksa|terapkan|kembalikan|verifikasi>
#         yoructl konfigurasi <KEY> <value>
#
# The agent may only reach this script through sudo. Every command lives in
# here; none is passed in by the agent. So the agent cannot run arbitrary
# commands - it can only ask for one of the 40 actions a human wrote and tested.

set -uo pipefail
umask 022
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin

VERSION="0.2.0"
LOG_DIR=/var/log/yoru
LOG_FILE="$LOG_DIR/tindakan.log"

# The server's state before Yoru touched anything. Kept in /var/backups - the
# place Ubuntu already uses for config backups, owned by root, outside
# everything the agent can write.
BASELINE_DIR=/var/backups/yoru

# ------------------------------------------------------------------- lock
# Two processes must never work the same control at once: a double-click in
# the dashboard, or the daily timer firing while someone presses a button.
#
# Two concurrent "periksa" runs are harmless - they only read. Two writers are
# not. In K06 one process writes the file and restarts mariadb while the other
# deletes it and restarts mariadb; the end state is unpredictable and BOTH
# report success.
#
# One lock for all ten controls, not one per control, because the controls
# share files: K01-K04 all write /etc/ssh/sshd_config.d, and K05 and K10 both
# edit /etc/default/ufw. Per-control locks would feel safe while two `sed -i`
# still ran against the same file.
#
# /run/lock is tmpfs, so a stale lock never survives a hard reboot.
LOCK_FILE=/run/lock/yoru.lock
LOCK_WAIT=120

take_lock() {
  command -v flock >/dev/null 2>&1 || return 2   # 2 = no flock on this box
  [ -d /run/lock ] || LOCK_FILE="$BASELINE_DIR/.lock"
  [ -d "${LOCK_FILE%/*}" ] || return 2
  exec 9>"$LOCK_FILE" 2>/dev/null || return 2
  chmod 600 "$LOCK_FILE" 2>/dev/null
  flock -w "$LOCK_WAIT" 9 || return 1            # 1 = timed out waiting
  return 0
}

# ------------------------------------------------------------------ output
# Every result is one line of JSON so the agent never has to guess a format.
value=""; message=""

finish() {  # finish <status> <ok> [value] [message]
  local status="$1" ok="$2" value="${3-}" message="${4-}"
  printf '{"versi":"%s","id":"%s","tindakan":"%s","status":"%s","berhasil":%s,"nilai":%s,"pesan":%s}\n' \
    "$VERSION" "${KID:-?}" "${ACTION:-?}" "$status" "$ok" \
    "$(json_quote "$value")" "$(json_quote "$message")"
  log_action "$status" "$ok" "$value" "$message"
  [ "$ok" = "true" ] && exit 0 || exit 1
}

json_quote() {  # JSON-safe string, or null when empty
  local s="${1-}"
  [ -z "$s" ] && { printf 'null'; return; }
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/ }"; s="${s//$'\r'/ }"; s="${s//$'\t'/ }"
  # apt and journalctl sometimes emit control characters. One of them breaks
  # the whole JSON line, including the log line the dashboard parses.
  s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037')
  printf '"%s"' "$s"
}

# One JSON line per action, written twice: to the combined log and to a
# per-control log, so "K05 history" needs no filtering of a large file.
log_action() {  # log_action <status> <ok> <value> <message>
  [ -d "$LOG_DIR" ] || mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  local line
  line=$(printf '{"waktu":%s,"versi":%s,"pemanggil":%s,"id":%s,"tindakan":%s,"status":%s,"berhasil":%s,"nilai":%s,"pesan":%s}' \
    "$(json_quote "$(date -Is)")" "$(json_quote "$VERSION")" "$(json_quote "${SUDO_USER:-?}")" \
    "$(json_quote "${KID:-?}")" "$(json_quote "${ACTION:-?}")" \
    "$(json_quote "$1")" "${2:-false}" "$(json_quote "${3-}")" "$(json_quote "${4-}")")

  append_log "$LOG_FILE" "$line"
  case "${KID:-}" in
    K[0-9][0-9]) append_log "$LOG_DIR/${KID}.log" "$line" ;;
  esac
}

append_log() {  # append_log <file> <line>
  # Created 640 from the start - a security tool's action log has no business
  # being readable by every account on the box.
  [ -e "$1" ] || { : > "$1" 2>/dev/null && chmod 640 "$1" 2>/dev/null; }
  printf '%s\n' "$2" >> "$1" 2>/dev/null || true
}

refuse() { KID="${KID:-?}"; ACTION="${ACTION:-?}"; finish "DITOLAK" "false" "" "$1"; }

# --------------------------------------------------------------- self check
# If this script were writable by anyone but root, the agent could rewrite it
# and then run it through sudo - which would make the sudoers restriction
# meaningless. So it is checked before anything else happens.
root_owned_only() {
  local path="$1" owner mode
  owner=$(stat -c '%U' "$path" 2>/dev/null) || return 1
  mode=$(stat -c '%a' "$path" 2>/dev/null) || return 1
  [ "$owner" = "root" ] || return 1
  (( (8#$mode & 8#022) == 0 )) || return 1
  return 0
}

self_check() {
  [ "$(id -u)" -eq 0 ] || refuse "must run as root through sudo"
  local self; self="$(readlink -f "$0")"
  local path
  for path in "$self" "$(dirname "$self")" /opt/yoru; do
    [ -e "$path" ] || continue
    root_owned_only "$path" || refuse "stopping: $path is writable by someone other than root"
  done
}

# ------------------------------------------------------------------ helpers
# /run/sshd is sshd's privilege-separation directory. Without it both `sshd -T`
# and `sshd -t` REFUSE TO RUN - not because openssh-server is missing, but
# because the directory is not there.
#
# On Ubuntu 24.04 it often is not. SSH starts from ssh.socket, while /run/sshd
# is created by ssh.service via RuntimeDirectory=sshd - and ssh.service only
# starts once something actually connects. So on a freshly booted server with
# no SSH login yet, K01 through K05 all report ERROR while sshd is installed
# and healthy. systemd also removes the directory again when ssh.service stops.
#
# Recreated with exactly the ownership and mode systemd uses.
ensure_run_sshd() {
  [ -d /run/sshd ] && return 0
  command -v sshd >/dev/null 2>&1 || return 1
  mkdir -p /run/sshd 2>/dev/null || return 1
  chown root:root /run/sshd 2>/dev/null
  chmod 0755 /run/sshd 2>/dev/null
}

# The real reason `sshd -T` failed, not our guess at it. Only called on the
# failure path.
#
# An earlier version discarded stderr and guessed "is openssh-server
# installed?" - and that guess was wrong in the most common case, so people
# reinstalled openssh-server over and over for something else entirely.
sshd_error_reason() {
  command -v sshd >/dev/null 2>&1 || {
    printf 'sshd tidak ada - openssh-server belum terpasang'; return 0; }
  local msg
  msg=$(sshd -T 2>&1 >/dev/null | tr '\n' ' ')
  msg=$(printf '%s' "$msg" | sed 's/  */ /g; s/^ //; s/ *$//' | cut -c1-180)
  [ -n "$msg" ] || msg='sshd -T gagal tanpa pesan apa pun'
  printf '%s' "$msg"
}

# An empty reading is a question, not a conclusion. When the probe itself
# cannot be read the status is ERROR, not GAGAL - an agent that reads GAGAL
# will try to apply the control while we do not yet know the state.
require_value() {  # require_value <value> <message>
  local v="${1//\//}"
  [ -n "$v" ] || finish ERROR false "$1" "$2"
}

# Same, but for sshd: the message carries sshd's own reason.
require_sshd_value() {  # require_sshd_value <value>
  local v="${1//\//}"
  [ -n "$v" ] || finish ERROR false "$1" "sshd -T gagal: $(sshd_error_reason)"
}

write_ssh_dropin() {  # write_ssh_dropin <filename> <body>
  printf '%s\n' "$2" > "/etc/ssh/sshd_config.d/$1" || return 1
  chmod 644 "/etc/ssh/sshd_config.d/$1"
  sshd -t 2>/dev/null || { rm -f "/etc/ssh/sshd_config.d/$1"; return 2; }
  systemctl reload ssh
}

remove_ssh_dropin() {
  rm -f "/etc/ssh/sshd_config.d/$1"
  sshd -t 2>/dev/null || return 2
  systemctl reload ssh
}

sshd_get() { sshd -T 2>/dev/null | awk -v k="^$1\$" '$1 ~ k {print $2; exit}'; }

# Find literal text in a command's output, without a pipe.
#
# DO NOT turn this into "command | grep -q text". This script runs under
# pipefail, and grep -q closes the pipe as soon as it matches; the upstream
# command dies of SIGPIPE (141) and pipefail reads that as failure. So a
# SUCCESSFUL match reads as a failure. That is what kept K02's precondition
# from ever passing on day one - see catalog/K02.yaml.
#
# Matching is literal like grep -F, not regex. Some patterns here contain
# parentheses and dots ("deny (incoming)", "0.0.0.0:3306") that would mean
# something else as a regex.
output_has() {  # output_has <literal-text> <command...>
  local text="$1"; shift
  local out
  out=$("$@" 2>/dev/null) || true
  [[ "$out" == *"$text"* ]]
}

# Install a package without giving up on ordinary situations, and without
# inventing a reason when it fails:
#   - an already-installed package never calls apt at all
#   - DPkg::Lock::Timeout makes apt WAIT for the lock instead of failing. On a
#     freshly booted VPS, apt-daily runs in the first minutes - exactly when
#     Yoru starts working.
#   - apt's own complaint is captured, not discarded
#
# The old version threw apt's output away and reported "check your internet
# connection" without having checked any connection. Guessing a cause and then
# writing it down as if it were a finding is the very thing we forbid the
# agent to do.
apt_error=""
install_pkg() {  # install_pkg <package>
  local pkg="$1" state out
  apt_error=""
  state=$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null) || state=""
  [ "$state" = "install ok installed" ] && return 0
  out=$(DEBIAN_FRONTEND=noninteractive apt-get -y \
          -o DPkg::Lock::Timeout=60 install "$pkg" 2>&1) && return 0
  apt_error=$(printf '%s' "$out" | tail -2 | tr '\n' ' ')
  return 1
}

# ------------------------------------------------------- hard preconditions
# Re-checked here even though the agent checks them too. "I already checked"
# is a promise, not a security boundary.
other_sudo_user_exists() {
  local user members
  members=$(getent group sudo | cut -d: -f4 | tr ',' ' ')
  for user in $members; do
    [ "$user" = "root" ] && continue
    local shell state
    shell=$(getent passwd "$user" | cut -d: -f7)
    case "$shell" in */nologin|*/false|"") continue ;; esac
    state=$(passwd -S "$user" 2>/dev/null | awk '{print $2}')
    [ "$state" = "P" ] || [ "$state" = "PS" ] || continue
    return 0
  done
  return 1
}

# The "server owner" - the human whose SSH key must be proven to work before
# K02 may switch off password login.
#
# Read from a root-owned file. SUDO_USER is not the primary source because the
# agent runs as yoru-agent, which by design has no key of its own.
server_owner() {
  local user=""
  [ -r /etc/yoru/pemilik ] && user=$(head -1 /etc/yoru/pemilik 2>/dev/null | tr -dc 'a-z0-9_-')
  [ -n "$user" ] || user="${SUDO_USER:-}"
  printf '%s' "$user"
}

ssh_key_proven() {
  [ -z "$(ssh_key_blocker)" ]
}

# Four different things can block K02, and each needs a different fix. An
# earlier version folded them into one sentence - correct, but the person
# reading it still had no idea what to do. Empty means clear to proceed.
ssh_key_blocker() {
  local user; user="$(server_owner)"
  [ -n "$user" ] || {
    printf 'pemilik server tidak diketahui - /etc/yoru/pemilik kosong atau tidak terbaca'
    return 0; }
  getent passwd "$user" >/dev/null || {
    printf "pemilik server tertulis '%s' tapi pengguna itu tidak ada di sini" "$user"
    return 0; }
  local home; home=$(getent passwd "$user" | cut -d: -f6)
  [ -s "$home/.ssh/authorized_keys" ] || {
    printf '%s belum punya kunci SSH di %s/.ssh/authorized_keys' "$user" "$home"
    return 0; }
  # An installed key is not a working key. Only one thing proves it: a login
  # that actually succeeded with it.
  output_has "Accepted publickey for $user" journalctl -t sshd --since "-30 days" || {
    printf 'kunci %s sudah terpasang tapi belum pernah dipakai login. Login sekali pakai kunci itu (ssh %s@<alamat-server>), lalu ulangi' "$user" "$user"
    return 0; }
}

# ---------------------------------------------------------- everyone on the box
# The owner is not the only person here. With five accounts where only the
# owner has a key, switching off password login locks four people out - and
# Yoru would report LULUS. A control that costs people their access does not
# count as successful.

# Read a whole sshd setting, not just its first word. allowusers/denyusers can
# hold many names. Done on a copy of $0 - touching $1 makes awk rebuild the
# line, which has silently broken our parsing before.
sshd_get_all() {
  sshd -T 2>/dev/null | awk -v k="^$1\$" '$1 ~ k { s=$0; sub(/^[^ ]+[ ]+/, "", s); print s; exit }'
}

# Is <name> in the space-separated <list>? Matched per word, not as a
# substring - "budi" must not match "budianto".
list_has() {
  local list=" $1 " name="$2"
  case "$list" in *" $name "*) return 0 ;; esac
  return 1
}

# Are these all plain names, with no patterns? AllowUsers may hold "bu*" or
# "budi@1.2.3.4". Matching a pattern literally could MISS someone who can
# still log in - and the one we miss is the one who gets locked out. So when a
# pattern is present the setting is ignored and every account is checked: K02
# becomes noisier, never more permissive.
list_is_plain() {
  local item
  for item in $1; do
    case "$item" in *[!a-zA-Z0-9_.-]*) return 1 ;; esac
  done
  return 0
}

# Who can still get in over SSH but has no key yet.
users_without_key() {
  local allow deny root_login use_allow=0 use_deny=0
  allow=$(sshd_get_all allowusers)
  deny=$(sshd_get_all denyusers)
  root_login=$(sshd_get permitrootlogin)

  if [ -n "$allow" ] && list_is_plain "$allow"; then use_allow=1; fi
  if [ -n "$deny" ] && list_is_plain "$deny"; then use_deny=1; fi

  # AllowGroups/DenyGroups are deliberately not read. Both only NARROW who may
  # log in, so ignoring them makes this list too long - never too short.

  local name uid home shell
  while IFS=: read -r name _ uid _ _ home shell; do
    # Service accounts cannot log in at all.
    case "$shell" in *nologin|*false|"") continue ;; esac

    if [ "$uid" = "0" ]; then
      # root counts only if it still gets in by password. With permitrootlogin
      # already "no" or "prohibit-password", K02 changes nothing for root and
      # naming it would just be noise.
      [ "$root_login" = "yes" ] || continue
    else
      [ "$uid" -ge 1000 ]  2>/dev/null || continue
      [ "$uid" -lt 65534 ] 2>/dev/null || continue
    fi

    if [ "$use_allow" = 1 ] && ! list_has "$allow" "$name"; then continue; fi
    if [ "$use_deny" = 1 ]  &&   list_has "$deny" "$name";  then continue; fi

    [ -s "$home/.ssh/authorized_keys" ] || printf '%s\n' "$name"
  done < <(getent passwd)
}

# ------------------------------------------------------- baseline recording
# Before a control is applied for the FIRST time on this server, copy the
# files it will touch and read the state that is currently in force.
#
# Why: "kembalikan" restores the DEFAULT value we wrote, not this server's
# original value. On a server whose default differs, those are two different
# things. This recording is what closes that gap later.
#
# Stored as files, not a database. Rollback is most needed while the server is
# already in trouble, and a database is one more thing that can be down with
# it. Files on disk still read from an emergency shell.

control_paths() {  # the files each control touches
  case "$1" in
    K01|K02|K03|K04) printf '%s\n' /etc/ssh/sshd_config /etc/ssh/sshd_config.d ;;
    K05)             printf '%s\n' /etc/default/ufw /etc/ufw ;;
    K06)             printf '%s\n' /etc/mysql/mariadb.conf.d ;;
    K07)             printf '%s\n' /etc/apt/apt.conf.d ;;
    K08)             printf '%s\n' /etc/audit/rules.d /etc/audit/auditd.conf ;;
    K09)             printf '%s\n' /etc/systemd/journald.conf /etc/systemd/journald.conf.d ;;
    K10)             printf '%s\n' /etc/sysctl.conf /etc/sysctl.d /etc/default/ufw ;;
  esac
}

# The state actually in force - not what a file says, but what is live. For
# K10 this matters most: the file can be deleted without changing the value
# the kernel holds.
read_effective() {
  case "$KID" in
    K01) sshd_get permitrootlogin ;;
    K02) sshd_get passwordauthentication ;;
    K03) printf '%s/%s' "$(sshd_get maxauthtries)" "$(sshd_get logingracetime)" ;;
    K04) printf 'mac_sha1=%s' "$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1')" ;;
    K05) ufw status 2>/dev/null | awk '/^Status:/ {print $2}' ;;
    K06) ss -tulpn 2>/dev/null | grep -o '[0-9.]*:3306' | head -1 ;;
    K07) systemctl is-enabled unattended-upgrades 2>/dev/null ;;
    K08) printf 'aturan=%s' "$(auditctl -l 2>/dev/null | grep -c '^-w')" ;;
    K09) k09_journal_cap ;;
    K10) k10_read ;;
  esac
}

# Once per server, never overwritten. The FIRST recording is the one that is
# genuinely "before Yoru"; a second would only photograph our own work.
record_baseline() {
  local dir="$BASELINE_DIR/$KID"
  [ -e "$dir/tercatat" ] && return 0

  mkdir -p "$dir/berkas" 2>/dev/null || return 1
  chmod 700 "$BASELINE_DIR" "$dir" 2>/dev/null

  local path
  while read -r path; do
    [ -e "$path" ] || continue
    cp -a --parents "$path" "$dir/berkas/" 2>/dev/null
  done < <(control_paths "$KID")

  printf '{"id":%s,"waktu":%s,"nilai_sebelum":%s,"versi_yoru":%s}\n' \
    "$(json_quote "$KID")" "$(json_quote "$(date -Is)")" \
    "$(json_quote "$(read_effective)")" "$(json_quote "$VERSION")" \
    > "$dir/keadaan.json" 2>/dev/null || return 1
  chmod 600 "$dir/keadaan.json" 2>/dev/null

  date -Is > "$dir/tercatat" 2>/dev/null || return 1
  return 0
}

# ---------------------------------------------------------------- idempotence
# Calling terapkan twice must not repeat the change. K06 shows why: each call
# restarts mariadb, so two calls drop database connections twice. Same end
# state, real disruption.
#
# Two conditions, not one:
#
#   1. our own drop-in exists with EXACTLY the expected content, and
#   2. the effective state already matches
#
# With only condition 2 ("value is already right, skip") there is a subtle
# hole: that value may come from someone else's file. If that file ever
# disappears the setting silently goes back to unsafe, because Yoru believed
# it was done. Condition 1 makes Yoru write its own file first - become the
# OWNER of that setting - and only then skip.
#
# One setting, one owner. Learned from ufw and sysctl in K10.
file_is() {  # file_is <file> <expected-content>
  [ -f "$1" ] || return 1
  [ "$(cat "$1" 2>/dev/null)" = "$2" ]
}

K01_BODY="PermitRootLogin no"
K02_BODY="PasswordAuthentication no"
K03_BODY="MaxAuthTries 3
LoginGraceTime 30"
K06_BODY="[mysqld]
bind-address = 127.0.0.1"
K09_BODY="[Journal]
Storage=persistent
Compress=yes
SystemMaxUse=500M
SystemKeepFree=1G
MaxRetentionSec=1month"

# --------------------------------------------------------------- the controls
k01() { case "$1" in
  periksa|verifikasi) value=$(sshd_get permitrootlogin)
    require_sshd_value "$value"
    [ "$value" = "no" ] && finish LULUS true "$value" || finish GAGAL true "$value" ;;
  terapkan)
    file_is "/etc/ssh/sshd_config.d/01-yoru-k01.conf" "$K01_BODY" && [ "$(sshd_get permitrootlogin)" = "no" ] \
      && finish DILEWATI true "no" "sudah diterapkan - sshd tidak di-reload lagi"
    other_sudo_user_exists || refuse "tidak ada user sudo lain yang aktif - menerapkan ini mengunci pemilik"
    write_ssh_dropin 01-yoru-k01.conf "PermitRootLogin no" || refuse "sshd menolak konfigurasi"
    value=$(sshd_get permitrootlogin)
    [ "$value" = "no" ] && finish LULUS true "$value" || { remove_ssh_dropin 01-yoru-k01.conf; refuse "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) remove_ssh_dropin 01-yoru-k01.conf; finish DIKEMBALIKAN true "$(sshd_get permitrootlogin)" ;;
esac }

k02() { local missing blocker; case "$1" in
  periksa|verifikasi) value=$(sshd_get passwordauthentication)
    require_sshd_value "$value"
    [ "$value" = "no" ] && finish LULUS true "$value" || finish GAGAL true "$value" ;;
  terapkan)
    file_is "/etc/ssh/sshd_config.d/01-yoru-k02.conf" "$K02_BODY" && [ "$(sshd_get passwordauthentication)" = "no" ] \
      && finish DILEWATI true "no" "sudah diterapkan - sshd tidak di-reload lagi"
    blocker="$(ssh_key_blocker)"
    [ -z "$blocker" ] || refuse "menerapkan ini menutup satu-satunya jalan masuk. $blocker"

    # A safe owner does not mean everyone is safe. Without this step K02 can
    # lock other residents out and still report LULUS.
    missing=$(users_without_key)
    missing="${missing//$'\n'/ }"; missing="${missing% }"
    if [ -n "$missing" ]; then
      if [ "$FORCE" = "1" ]
        then log_action "PERINGATAN" "true" "" "--paksa dipakai, akun tanpa kunci SSH ikut terkunci: $missing"
        else refuse "akun ini belum punya kunci SSH dan akan terkunci di luar: $missing - pasangi kunci dulu, atau ulangi dengan --paksa kalau akun itu memang sudah tidak dipakai"
      fi
    fi

    write_ssh_dropin 01-yoru-k02.conf "PasswordAuthentication no" || refuse "sshd menolak konfigurasi"
    value=$(sshd_get passwordauthentication)
    [ "$value" = "no" ] && finish LULUS true "$value" || { remove_ssh_dropin 01-yoru-k02.conf; refuse "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) remove_ssh_dropin 01-yoru-k02.conf; finish DIKEMBALIKAN true "$(sshd_get passwordauthentication)" ;;
esac }

k03() { case "$1" in
  periksa|verifikasi) value="$(sshd_get maxauthtries)/$(sshd_get logingracetime)"
    require_sshd_value "$value"
    [ "$value" = "3/30" ] && finish LULUS true "$value" || finish GAGAL true "$value" ;;
  terapkan)
    file_is "/etc/ssh/sshd_config.d/01-yoru-k03.conf" "$K03_BODY" && [ "$(sshd_get maxauthtries)/$(sshd_get logingracetime)" = "3/30" ] \
      && finish DILEWATI true "3/30" "sudah diterapkan - sshd tidak di-reload lagi"
    write_ssh_dropin 01-yoru-k03.conf "MaxAuthTries 3
LoginGraceTime 30" || refuse "sshd menolak konfigurasi"
    value="$(sshd_get maxauthtries)/$(sshd_get logingracetime)"
    [ "$value" = "3/30" ] && finish LULUS true "$value" || { remove_ssh_dropin 01-yoru-k03.conf; refuse "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) remove_ssh_dropin 01-yoru-k03.conf; finish DIKEMBALIKAN true "$(sshd_get maxauthtries)/$(sshd_get logingracetime)" ;;
esac }

K04_BODY="Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512"

k04() { local weak; case "$1" in
  periksa|verifikasi)
    sshd -T >/dev/null 2>&1 || finish ERROR false "" "sshd -T gagal: $(sshd_error_reason)"
    weak=$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1'); value="mac_sha1=$weak"
    [ "$weak" = "0" ] && finish LULUS true "$value" || finish GAGAL true "$value" ;;
  terapkan)
    file_is "/etc/ssh/sshd_config.d/01-yoru-k04.conf" "$K04_BODY" && [ "$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1')" = "0" ] \
      && finish DILEWATI true "mac_sha1=0" "sudah diterapkan - sshd tidak di-reload lagi"
    write_ssh_dropin 01-yoru-k04.conf "$K04_BODY" || refuse "sshd menolak daftar algoritma"
    weak=$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1'); value="mac_sha1=$weak"
    [ "$weak" = "0" ] && finish LULUS true "$value" || { remove_ssh_dropin 01-yoru-k04.conf; refuse "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) remove_ssh_dropin 01-yoru-k04.conf
    finish DIKEMBALIKAN true "mac_sha1=$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1')" ;;
esac }

# The SSH port is read from sshd itself, never assumed to be 22.
#
# Providers move it - CloudBaik uses 4422. Hard-coding it makes K05 refuse to
# run on that server, and a control that can never run is the same as no
# control. The refusal even sounds reasonable ("no sshd on port 22"), so
# nobody gets suspicious.
#
# `sshd -T` prints one "port <n>" line per port, so a server listening on two
# is handled too.
ssh_ports() { sshd -T 2>/dev/null | awk '/^port /{print $2}'; }

# ---------------------------------------------------------- other open ports
# SSH is not the only door. Real servers also run web, a control panel
# (aaPanel, CyberPanel), or something else. Turning on a deny-all firewall
# without handling those ports locks the owner out of their own panel.
#
# The tempting fix is to memorise the numbers: 8888 for aaPanel, 8090 for
# CyberPanel, 2083 for cPanel. That is the same mistake as pinning SSH to 22,
# only better dressed - people change their panel port, and there are hundreds
# of panels we have never heard of.
#
# So we do what we do for SSH: READ REALITY, do not guess.

# Every TCP port actually open to the outside, with its process name.
#
# Loopback addresses are dropped - 127.x and ::1 cannot be reached from the
# internet, so they are not holes. Listing them would bury the owner in
# questions about ports that are already safe, and questions that feel
# pointless are the fastest way to make someone stop reading.
#
# UDP is deliberately excluded: what locks people out is TCP (ssh, web,
# panel). Including UDP would only add noise like the DHCP client port. This
# is a known gap, written down so nobody mistakes it for complete.
public_ports() {
  local out
  out=$(ss -tlnp 2>/dev/null) || return 0
  printf '%s\n' "$out" | awk '
    $1 != "LISTEN" { next }
    {
      addr = $4
      port = addr; sub(/.*:/, "", port)
      host = addr; sub(/:[^:]*$/, "", host)
      sub(/%.*$/, "", host)             # "127.0.0.53%lo" -> "127.0.0.53"
      if (host ~ /^127\./)  next
      if (host == "[::1]")  next
      if (host == "::1")    next
      proc = "?"
      if (match($0, /"[^"]+"/)) proc = substr($0, RSTART + 1, RLENGTH - 2)
      print port " " proc
    }' | sort -k1,1n -u
}

# Ports the owner has already vouched for.
#
# Two sources, on purpose:
#   /etc/yoru/yoru.conf  PORT_DIIZINKAN="80 443"   <- root, agent cannot write
#   /var/lib/yoru/port-disetujui                   <- agent writes owner's answers
#
# The second one is agent-writable by design: if the owner had to SSH in and
# edit a file, the whole promise of "for people without an IT team" collapses.
# It is not a widening of power either - the agent can already call "K05
# kembalikan", which turns the firewall off entirely, so adding one allowed
# port is smaller than what it can already do. What does not change: every
# allowed port lands in the root-owned audit trail the agent cannot edit.
#
# Anyone wanting it stricter can use yoru.conf alone and leave the second file
# empty.
DATA_DIR=/var/lib/yoru
PORT_FILE="$DATA_DIR/port-disetujui"
CONFIG_FILE=/etc/yoru/yoru.conf

config_get() {  # config_get <key> - read as text, NEVER sourced
  [ -r "$CONFIG_FILE" ] || return 0
  awk -v k="$1" '
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      if (line ~ /^#/ || line == "") next
      p = index(line, "=")
      if (p == 0) next
      key = substr(line, 1, p - 1)
      val = substr(line, p + 1)
      sub(/[[:space:]]+$/, "", key)
      sub(/^[[:space:]]+/, "", val); sub(/[[:space:]]+$/, "", val)
      gsub(/^"|"$/, "", val)
      if (key == k) { print val; exit }
    }' "$CONFIG_FILE" 2>/dev/null
}

is_port() {  # digits only, 1-65535
  case "$1" in ""|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

approved_ports() {
  local result="" p line
  for p in $(config_get PORT_DIIZINKAN); do
    is_port "$p" && result="$result $p"
  done
  if [ -r "$PORT_FILE" ]; then
    while read -r line || [ -n "$line" ]; do
      line="${line%%#*}"                 # strip the note
      line="${line//[[:space:]]/}"
      is_port "$line" && result="$result $line"
    done < "$PORT_FILE"
  fi
  printf '%s' "${result# }"
}

# Another firewall already running on the same server.
#
# Two firewalls are not a configuration, they are a race, and the winner
# changes with service start order. Same lesson as K10 and ufw over
# log_martians, at the scale of the whole rule table.
#
# Only CSF and firewalld are checked: neither ships with stock Ubuntu, so
# finding one means it was installed on purpose. nftables is not checked
# because ufw itself uses it underneath, and we have not tested how to tell
# "ufw's nftables" from "the owner's nftables". Written down so this is not
# mistaken for complete.
other_firewall() {
  if command -v csf >/dev/null 2>&1 || [ -f /etc/csf/csf.conf ]; then
    printf 'CSF (biasanya bawaan cPanel)'; return 0
  fi
  if [ "$(systemctl is-active firewalld 2>/dev/null)" = "active" ]; then
    printf 'firewalld'; return 0
  fi
  return 1
}

# Open ports the owner has not vouched for, excluding the SSH ports.
unapproved_ports() {  # unapproved_ports "<ssh-ports>" "<approved-ports>"
  local ssh_port="$1" approved="$2" pending="" p proc
  while read -r p proc; do
    [ -n "$p" ] || continue
    list_has "$ssh_port" "$p" && continue
    list_has "$approved" "$p" && continue
    pending="$pending $p($proc)"
  done < <(public_ports)
  printf '%s' "${pending# }"
}

k05() { local p ports heard approved pending other; case "$1" in
  periksa|verifikasi)
    command -v ufw >/dev/null 2>&1 || finish ERROR false "" "ufw tidak terpasang - tidak bisa diperiksa"

    # The unanswered-port list rides along in "pesan". It is raw material for
    # Hermes to build the question to the owner: "port 8888 is open, used by
    # python3, is that your panel?" - and that answer is what later lets
    # terapkan run.
    pending="$(unapproved_ports "$(ssh_ports)" "$(approved_ports)")"
    [ -z "$pending" ] || pending="port terbuka belum dijawab pemilik: $pending"

    value=$(ufw status verbose 2>/dev/null | awk '/^Status:/ {print $2}')
    if [ "$value" = "active" ] && output_has 'deny (incoming)' ufw status verbose
      then finish LULUS true "$value" "$pending"
      else finish GAGAL true "${value:-tidak-aktif}" "$pending"; fi ;;
  terapkan)
    # Without this guard every ufw command fails silently (output discarded)
    # and the empty status reads as "ufw failed to activate" - the wrong
    # cause, exactly the mistake we already made once in K07.
    command -v ufw >/dev/null 2>&1 || refuse "ufw tidak terpasang - pasang dulu: apt-get install ufw"

    other="$(other_firewall)" && refuse "server ini sudah memakai $other - dua firewall akan saling menimpa aturan. Yoru tidak menyalakan ufw di sini"

    ports="$(ssh_ports)"
    [ -n "$ports" ] || refuse "tidak bisa membaca port SSH: $(sshd_error_reason)"

    # The port must actually be listening, not merely written in a config.
    # Turning on a firewall based on intent rather than reality is how you
    # lock yourself out.
    heard=0
    for p in $ports; do output_has ":$p " ss -tulpn && heard=1; done
    [ "$heard" = "1" ] || refuse "sshd tidak terdengar di port mana pun dari daftar: $(printf '%s ' $ports)"

    # Other services that are open but unanswered. Yoru cannot tell whether
    # 8888 is a panel or a hole - only the owner can. So stop and ask, DO NOT
    # guess. Allowing automatically makes the firewall pointless; leaving them
    # closed locks the owner out of their own panel.
    approved="$(approved_ports)"
    pending="$(unapproved_ports "$ports" "$approved")"
    [ -z "$pending" ] || refuse "port ini terbuka tapi belum dijawab pemilik: $pending - tanyakan dulu, lalu catat portnya di $PORT_FILE atau PORT_DIIZINKAN di $CONFIG_FILE"

    # Allowed BEFORE the firewall comes up. The other order locks you out.
    for p in $ports; do
      ufw allow "$p"/tcp comment 'SSH - yoru K05' >/dev/null 2>&1
    done
    for p in $approved; do
      ufw allow "$p"/tcp comment 'disetujui pemilik - yoru K05' >/dev/null 2>&1
    done
    [ -z "$approved" ] || log_action "PERINGATAN" "true" "" "port disetujui pemilik ikut diizinkan: $approved"

    ufw default deny incoming  >/dev/null 2>&1
    ufw default allow outgoing >/dev/null 2>&1
    ufw --force enable         >/dev/null 2>&1
    value=$(ufw status 2>/dev/null | awk '/^Status:/ {print $2}')
    [ "$value" = "active" ] && finish LULUS true "$value" || refuse "ufw gagal aktif" ;;
  kembalikan)
    # With no ufw there is nothing to roll back. Reporting DIKEMBALIKAN with
    # an empty value would be a lie that sounds like success.
    command -v ufw >/dev/null 2>&1 || finish DILEWATI true "ufw tidak terpasang"
    ufw --force reset >/dev/null 2>&1
    finish DIKEMBALIKAN true "$(ufw status 2>/dev/null | awk '/^Status:/ {print $2}')" ;;
esac }

K06_FILE=/etc/mysql/mariadb.conf.d/zz-yoru-k06.cnf
k06() { case "$1" in
  periksa|verifikasi)
    if output_has '0.0.0.0:3306' ss -tulpn; then value="0.0.0.0:3306"; finish GAGAL true "$value"
    elif output_has '127.0.0.1:3306' ss -tulpn; then finish LULUS true "127.0.0.1:3306"
    else finish DILEWATI true "tidak ada layanan di 3306"; fi ;;
  terapkan)
    # Not installed means "does not apply here", not "failed". This used to be
    # DITOLAK, which looked exactly as red in the dashboard as a control that
    # was genuinely broken.
    [ -d /etc/mysql/mariadb.conf.d ] \
      || finish DILEWATI true "tidak ada layanan di 3306" "MariaDB tidak terpasang - tidak ada yang perlu dikunci di server ini"
    # mariadb is NOT restarted when everything is already correct
    file_is "$K06_FILE" "$K06_BODY" && output_has '127.0.0.1:3306' ss -tulpn \
      && finish DILEWATI true "127.0.0.1:3306" "sudah diterapkan - mariadb tidak direstart"
    printf '[mysqld]\nbind-address = 127.0.0.1\n' > "$K06_FILE"; chmod 644 "$K06_FILE"
    systemctl restart mariadb || { rm -f "$K06_FILE"; refuse "mariadb gagal start, sudah dikembalikan"; }
    sleep 2
    if output_has '127.0.0.1:3306' ss -tulpn
      then finish LULUS true "127.0.0.1:3306"
      else rm -f "$K06_FILE"; systemctl restart mariadb; refuse "verifikasi gagal, sudah dikembalikan"; fi ;;
  kembalikan) rm -f "$K06_FILE"; systemctl restart mariadb; sleep 2
    finish DIKEMBALIKAN true "$(ss -tulpn 2>/dev/null | grep -o '[0-9.]*:3306' | head -1)" ;;
esac }

k07() { case "$1" in
  periksa|verifikasi) value=$(systemctl is-enabled unattended-upgrades 2>/dev/null)
    [ "$value" = "enabled" ] && finish LULUS true "$value" || finish GAGAL true "${value:-tidak-terpasang}" ;;
  terapkan)
    install_pkg unattended-upgrades \
      || refuse "gagal memasang unattended-upgrades. apt bilang: ${apt_error:-tidak ada keterangan}"
    printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' \
      > /etc/apt/apt.conf.d/20auto-upgrades
    systemctl enable --now unattended-upgrades >/dev/null 2>&1
    value=$(systemctl is-enabled unattended-upgrades 2>/dev/null)
    [ "$value" = "enabled" ] && finish LULUS true "$value" || refuse "layanan tidak enabled setelah dipasang" ;;
  kembalikan) systemctl disable --now unattended-upgrades >/dev/null 2>&1
    finish DIKEMBALIKAN true "$(systemctl is-enabled unattended-upgrades 2>/dev/null)" ;;
esac }

K08_FILE=/etc/audit/rules.d/zz-yoru-k08.rules
K08_BODY='# K08 - jejak audit Yoru
-w /etc/passwd -p wa -k identitas
-w /etc/shadow -p wa -k identitas
-w /etc/group -p wa -k identitas
-w /etc/gshadow -p wa -k identitas
-w /etc/sudoers -p wa -k hak_akses
-w /etc/sudoers.d/ -p wa -k hak_akses
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /etc/ssh/sshd_config.d/ -p wa -k ssh_config
-w /etc/ufw/ -p wa -k firewall
-w /etc/sysctl.d/99-yoru-k10.conf -p wa -k yoru_kontrol
-w /etc/systemd/journald.conf.d/99-yoru-k09.conf -p wa -k yoru_kontrol
-w /etc/mysql/mariadb.conf.d/zz-yoru-k06.cnf -p wa -k yoru_kontrol'

k08() { local n; case "$1" in
  periksa|verifikasi) n=$(auditctl -l 2>/dev/null | grep -c '^-w'); value="aturan=$n"
    [ "$n" -ge 12 ] && finish LULUS true "$value" || finish GAGAL true "$value" ;;
  terapkan)
    file_is "$K08_FILE" "$K08_BODY" && [ "$(auditctl -l 2>/dev/null | grep -c '^-w')" -ge 12 ] 2>/dev/null \
      && finish DILEWATI true "aturan=$(auditctl -l 2>/dev/null | grep -c '^-w')" "sudah diterapkan - aturan audit tidak dimuat ulang"
    if ! command -v auditctl >/dev/null 2>&1; then
      install_pkg auditd \
        || refuse "gagal memasang auditd. apt bilang: ${apt_error:-tidak ada keterangan}"
    fi
    command -v auditctl >/dev/null 2>&1 || refuse "paket auditd terpasang tapi perintah auditctl tidak ditemukan"
    # The zz- prefix is required: the stock audit.rules starts with -D, which
    # clears every rule, and a numbered file loads earlier and gets wiped.
    printf '%s\n' "$K08_BODY" > "$K08_FILE"; chmod 640 "$K08_FILE"
    systemctl start auditd >/dev/null 2>&1
    augenrules --load >/dev/null 2>&1
    n=$(auditctl -l 2>/dev/null | grep -c '^-w'); value="aturan=$n"
    [ "$n" -ge 12 ] && finish LULUS true "$value" || { rm -f "$K08_FILE"; augenrules --load >/dev/null 2>&1; refuse "aturan tidak termuat, sudah dikembalikan"; } ;;
  kembalikan) rm -f "$K08_FILE"; augenrules --load >/dev/null 2>&1
    finish DIKEMBALIKAN true "aturan=$(auditctl -l 2>/dev/null | grep -c '^-w')" ;;
esac }

K09_FILE=/etc/systemd/journald.conf.d/99-yoru-k09.conf
# journald prints whatever unit fits - M here, G on a big-disk server. The old
# pattern only matched M, so on a large VPS the reading came back empty and
# was read as "tidak-terbaca": an empty result used as a conclusion, exactly
# what we forbid.
k09_journal_cap() { journalctl -b -t systemd-journald --no-pager 2>/dev/null | grep -oE 'max [0-9.]+[KMGT]' | tail -1; }
k09() { case "$1" in
  periksa|verifikasi) value=$(k09_journal_cap)
    journalctl --disk-usage >/dev/null 2>&1 || finish ERROR false "" "journalctl tidak bisa dibaca"
    if [ -d /var/log/journal ] && [ "$value" = "max 500.0M" ]
      then finish LULUS true "$value"; else finish GAGAL true "${value:-tidak-terbaca}"; fi ;;
  terapkan)
    file_is "$K09_FILE" "$K09_BODY" && [ -d /var/log/journal ] && [ "$(k09_journal_cap)" = "max 500.0M" ] \
      && finish DILEWATI true "max 500.0M" "sudah diterapkan - journald tidak direstart"
    mkdir -p /etc/systemd/journald.conf.d
    printf '[Journal]\nStorage=persistent\nCompress=yes\nSystemMaxUse=500M\nSystemKeepFree=1G\nMaxRetentionSec=1month\n' > "$K09_FILE"
    chmod 644 "$K09_FILE"; systemctl restart systemd-journald; sleep 1
    value=$(k09_journal_cap)
    [ "$value" = "max 500.0M" ] && finish LULUS true "$value" || { rm -f "$K09_FILE"; systemctl restart systemd-journald; refuse "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) rm -f "$K09_FILE"; systemctl restart systemd-journald; sleep 1
    finish DIKEMBALIKAN true "$(k09_journal_cap)" ;;
esac }

K10_FILE=/etc/sysctl.d/99-yoru-k10.conf
K10_BODY='# K10 - setelan kernel jaringan (Yoru)
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.icmp_echo_ignore_all = 0
net.ipv4.tcp_syncookies = 1
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
net.ipv6.conf.all.accept_ra = 0
net.ipv6.conf.default.accept_ra = 0'

k10_read() {
  local martians redirects router_ad
  martians=$(sysctl -n net.ipv4.conf.all.log_martians     2>/dev/null)
  redirects=$(sysctl -n net.ipv4.conf.all.secure_redirects 2>/dev/null)
  router_ad=$(sysctl -n net.ipv6.conf.all.accept_ra        2>/dev/null)
  # A server with IPv6 fully disabled has no such knob at all. That is not a
  # failure - no IPv6 means nothing to secure. Without this, K10 would report
  # GAGAL forever on any VPS without IPv6.
  [ -n "$router_ad" ] || router_ad="na"
  printf '%s/%s/%s' "${martians:-?}" "${redirects:-?}" "$router_ad"
}
k10_ok() { case "$1" in "1/0/0"|"1/0/na") return 0 ;; *) return 1 ;; esac; }
k10() { case "$1" in
  periksa|verifikasi) value=$(k10_read)
    case "$value" in *'?'*) finish ERROR false "$value" "sysctl ipv4 tidak bisa dibaca" ;; esac
    k10_ok "$value" && finish LULUS true "$value" || finish GAGAL true "$value" ;;
  terapkan)
    file_is "$K10_FILE" "$K10_BODY" && k10_ok "$(k10_read)" && output_has '#yoru-k10#IPT_SYSCTL=' cat /etc/default/ufw \
      && finish DILEWATI true "$(k10_read)" "sudah diterapkan - sysctl tidak dimuat ulang"
    printf '%s\n' "$K10_BODY" > "$K10_FILE"; chmod 644 "$K10_FILE"
    # ufw re-applies its own sysctl on every start and overwrites log_martians
    # back to 0. Take ufw out of the sysctl business so one setting has one
    # owner. Everything ufw used to set is already covered by our file.
    #
    # The marker goes in FRONT and nothing is appended behind it. The original
    # value must stay intact, because it is the only material kembalikan has
    # to restore this line exactly as it was. Long version in catalog/K10.yaml.
    if grep -q '^IPT_SYSCTL=' /etc/default/ufw 2>/dev/null; then
      sed -i 's|^IPT_SYSCTL=|#yoru-k10#IPT_SYSCTL=|' /etc/default/ufw
    fi
    sysctl -p "$K10_FILE" >/dev/null 2>&1
    value=$(k10_read)
    k10_ok "$value" && finish LULUS true "$value" || refuse "verifikasi gagal, nilai=$value" ;;
  kembalikan)
    # The kernel keeps the last value - deleting the file is NOT enough.
    rm -f "$K10_FILE"
    # Only lines Yoru marked itself are uncommented. Lines commented out by
    # the owner or the distro are left alone: Yoru undoes its own work, it
    # does not guess what ought to be active.
    sed -i 's|^#yoru-k10#IPT_SYSCTL=|IPT_SYSCTL=|' /etc/default/ufw 2>/dev/null
    sysctl -w net.ipv4.conf.all.log_martians=0 \
             -w net.ipv4.conf.default.log_martians=0 \
             -w net.ipv4.conf.all.secure_redirects=1 \
             -w net.ipv4.conf.default.secure_redirects=1 \
             -w net.ipv4.conf.default.accept_source_route=1 \
             -w net.ipv6.conf.all.accept_ra=1 \
             -w net.ipv6.conf.default.accept_ra=1 >/dev/null 2>&1
    finish DIKEMBALIKAN true "$(k10_read)" ;;
esac }

# ------------------------------------------------------ settings from the web
# So the owner never has to open a terminal just to change a bot token.
#
# The keys that may be set from here are LIMITED to the list below, and every
# value is shape-checked. Not because the other keys are dangerous, but
# because the same file holds DASHBOARD_TOKEN: if the dashboard could write
# any key, a compromised dashboard could change its own token - and the owner
# would lose the only thing separating them from an attacker.
#
# The value is NEVER written to the log. Only the key name is.
config_set_line() {  # config_set_line <file> <key> <value>
  local file="$1" key="$2" val="$3" tmp
  tmp=$(mktemp) || return 1
  awk -v k="$key" -v v="$val" '
    BEGIN { done = 0 }
    {
      copy = $0
      sub(/^[[:space:]]+/, "", copy)
      if (copy ~ /^#/ || copy == "") { print; next }
      p = index(copy, "=")
      if (p == 0) { print; next }
      name = substr(copy, 1, p - 1)
      sub(/[[:space:]]+$/, "", name)
      if (name == k) { print k "=\"" v "\""; done = 1; next }
      print
    }
    END { if (!done) print k "=\"" v "\"" }
  ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  # The content is copied, not the file moved, so the original owner and mode
  # (root:yoru-agent 640) stay as they were.
  cat "$tmp" > "$file" || { rm -f "$tmp"; return 1; }
  rm -f "$tmp"
}

set_config() {  # set_config <KEY> <value>
  local key="$1" val="$2" file=/etc/yoru/yoru.conf
  [ -f "$file" ] || refuse "$file tidak ada - jalankan install.sh dulu"

  case "$key" in
    TELEGRAM_TOKEN)
      [ -z "$val" ] || [[ "$val" =~ ^[0-9]{5,}:[A-Za-z0-9_-]{30,}$ ]] \
        || refuse "token bot bentuknya <angka>:<huruf-angka>, contoh 8123456789:AAG3x... - salin utuh dari BotFather" ;;
    HERMES_URL)
      [ -z "$val" ] || [[ "$val" =~ ^https?://[A-Za-z0-9._-]+(:[0-9]{1,5})?$ ]] \
        || refuse "alamat Hermes bentuknya http://host:port, contoh http://127.0.0.1:8080" ;;
    AI_MODEL)
      [ -z "$val" ] || [[ "$val" =~ ^[A-Za-z0-9._:/-]{1,80}$ ]] \
        || refuse "nama model cuma boleh huruf, angka, titik, garis, titik dua, dan garis miring" ;;
    TELEGRAM_CHAT_ID)
      [ -z "$val" ] || [[ "$val" =~ ^-?[0-9]{1,20}$ ]] \
        || refuse "chat id harus angka (boleh diawali minus untuk grup)" ;;
    NAMA_SERVER)
      [ -z "$val" ] || [[ "$val" =~ ^[A-Za-z0-9._-]{1,60}$ ]] \
        || refuse "nama server cuma boleh huruf, angka, titik, garis, dan garis bawah" ;;
    PORT_DIIZINKAN)
      [ -z "$val" ] || [[ "$val" =~ ^[0-9]{1,5}([[:space:]]+[0-9]{1,5})*$ ]] \
        || refuse "port dipisah spasi, contoh: 80 443 8000" ;;
    LEWATI_KONTROL)
      [ -z "$val" ] || [[ "$val" =~ ^K(0[1-9]|10)(,K(0[1-9]|10))*$ ]] \
        || refuse "isi dengan nomor kontrol dipisah koma, contoh: K05,K06" ;;
    JAM_PENJAGAAN)
      [[ "$val" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || refuse "jam harus bentuk HH:MM" ;;
    ZONA_WAKTU)
      [ "$val" = "UTC" ] || [[ "$val" =~ ^[A-Za-z]+/[A-Za-z_+-]+$ ]] \
        || refuse "zona waktu contohnya Asia/Jakarta atau UTC" ;;
    *)
      refuse "kunci '$key' tidak boleh diubah dari dashboard - sunting langsung di $file" ;;
  esac

  config_set_line "$file" "$key" "$val" || refuse "gagal menulis $file"
  chown root:yoru-agent "$file" 2>/dev/null; chmod 640 "$file" 2>/dev/null
  finish DISIMPAN true "$key" "tersimpan di $file"
}

# ---------------------------------------------------------------------- main
KID=""; ACTION=""; FORCE=0

# Settings path first: it takes three arguments and the second one is a key,
# not an action name.
if [ "${1-}" = "konfigurasi" ]; then
  KID="konfigurasi"; ACTION="set"
  [ $# -eq 3 ] || refuse "pakai: yoructl konfigurasi <KUNCI> <nilai>"
  self_check
  set_config "$2" "$3"
fi

case $# in
  2) : ;;
  3) KID="?"; ACTION="?"
     [ "$3" = "--paksa" ] || refuse "pilihan tidak dikenal: $3"
     FORCE=1 ;;
  *) KID="?"; ACTION="?"
     refuse "pakai: yoructl <K01..K10> <periksa|terapkan|kembalikan|verifikasi> [--paksa]" ;;
esac

KID="$1"; ACTION="$2"
[[ "$KID"    =~ ^K(0[1-9]|10)$ ]] || refuse "nomor kontrol tidak dikenal"
[[ "$ACTION" =~ ^(periksa|terapkan|kembalikan|verifikasi)$ ]] || refuse "tindakan tidak dikenal"

# --paksa is a HUMAN decision, not the agent's.
#
# The sudoers line does not restrict arguments, so technically the agent could
# type --paksa itself. The block has to live here. Without it, one
# maliciously crafted log line could end with the agent forcing K02 and
# locking the server's residents out - the exact scenario this whole design
# exists to prevent.
AGENT=yoru-agent
if [ "$FORCE" = "1" ] && [ "${SUDO_USER:-}" = "$AGENT" ]; then
  refuse "--paksa tidak boleh dipakai agent - ini keputusan manusia, jalankan sendiri lewat sudo"
fi

self_check
ensure_run_sshd

# The lock covers WRITING actions only. periksa and verifikasi just read, so
# they stay free: the daily watch cycle is all periksa, and there is no reason
# to make it queue behind a long apply.
case "$ACTION" in
  terapkan|kembalikan)
    take_lock
    case "$?" in
      1) refuse "kontrol lain sedang diterapkan atau dikembalikan - sudah menunggu ${LOCK_WAIT} detik, coba lagi nanti" ;;
      2) log_action "PERINGATAN" "true" "" "flock tidak tersedia - jalan tanpa kunci, jangan panggil dua tindakan sekaligus" ;;
    esac ;;
esac

# Record the baseline before touching anything. Only for terapkan: periksa and
# verifikasi change nothing, and kembalikan needs the existing recording
# rather than a fresh one.
#
# If recording fails, terapkan still runs but the failure is logged. Rollback
# keeps working from the catalog recipe, so this is not a loss of rollback -
# only of the ability to restore this server's original value. What is not
# acceptable is failing silently and letting someone believe a backup exists.
if [ "$ACTION" = "terapkan" ]; then
  if ! record_baseline; then
    log_action "PERINGATAN" "true" "" "keadaan asal gagal direkam ke $BASELINE_DIR/$KID - terapkan tetap dilanjutkan"
  fi
fi

"$(printf 'k%02d' "$((10#${KID#K}))")" "$ACTION"
refuse "tindakan tidak tertangani"
