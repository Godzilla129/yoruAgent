#!/bin/bash
# yoructl - satu-satunya pintu Yoru ke hak root.
#
# Pakai:  yoructl <K01..K10> <periksa|terapkan|kembalikan|verifikasi>
#
# Agent hanya boleh memanggil skrip ini lewat sudo. Perintah aslinya ada di
# dalam sini, bukan dikirim agent. Artinya agent tidak bisa menjalankan
# perintah sembarangan - dia cuma bisa meminta salah satu dari 40 tindakan
# yang sudah ditulis dan diuji manusia.

set -uo pipefail
umask 022
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin

VERSI="0.1.7"
LOG_DIR=/var/log/yoru
LOG="$LOG_DIR/tindakan.log"

# Rekaman keadaan asal server, sebelum Yoru menyentuh apa pun.
# Ditaruh di /var/backups - tempat yang memang dipakai Ubuntu untuk cadangan
# konfigurasi, dan milik root, di luar apa pun yang bisa ditulis agent.
DIR_ASAL=/var/backups/yoru

# ------------------------------------------------------------------ kunci
# Satu kontrol tidak boleh dikerjakan dua proses sekaligus. Contoh yang
# paling gampang kejadian: orang klik dua kali di dashboard, atau timer
# harian jalan pas ada yang mencet tombol.
#
# Yang berbahaya bukan dua "periksa" barengan - itu cuma baca. Yang
# berbahaya "terapkan" dan "kembalikan" barengan. Di K06 misalnya: satu
# proses menulis berkas lalu restart mariadb, satu lagi menghapus berkas
# lalu restart mariadb. Hasil akhirnya tidak bisa ditebak, dan DUA-DUANYA
# melapor sukses.
#
# Kuncinya SATU untuk semua kontrol, bukan satu per kontrol. Alasannya
# kontrol-kontrol ini berbagi berkas: K01 sampai K04 sama-sama menulis ke
# /etc/ssh/sshd_config.d, dan K05 dengan K10 sama-sama menyunting
# /etc/default/ufw. Kunci per kontrol akan terasa aman padahal dua sed -i
# masih bisa jalan bersamaan di berkas yang sama.
#
# /run/lock dipilih karena tmpfs - isinya hilang saat reboot, jadi kunci
# yatim tidak pernah tertinggal setelah server mati mendadak.
KUNCI=/run/lock/yoru.lock
TUNGGU_KUNCI=120

ambil_kunci() {
  command -v flock >/dev/null 2>&1 || return 2   # 2 = flock tidak ada
  [ -d /run/lock ] || KUNCI="$DIR_ASAL/.kunci"
  [ -d "${KUNCI%/*}" ] || return 2
  exec 9>"$KUNCI" 2>/dev/null || return 2
  chmod 600 "$KUNCI" 2>/dev/null
  flock -w "$TUNGGU_KUNCI" 9 || return 1        # 1 = keburu habis waktunya
  return 0
}

# ---------------------------------------------------------------- keluaran
# Semua keluaran berbentuk JSON satu baris supaya gampang dibaca agent.
lolos=""; nilai=""; pesan=""

selesai() {  # selesai <status> <berhasil> [nilai] [pesan]
  local status="$1" berhasil="$2" nilai="${3-}" pesan="${4-}"
  printf '{"versi":"%s","id":"%s","tindakan":"%s","status":"%s","berhasil":%s,"nilai":%s,"pesan":%s}\n' \
    "$VERSI" "${KID:-?}" "${AKSI:-?}" "$status" "$berhasil" \
    "$(kutip "$nilai")" "$(kutip "$pesan")"
  catat "$status" "$berhasil" "$nilai" "$pesan"
  [ "$berhasil" = "true" ] && exit 0 || exit 1
}

kutip() {  # bikin string aman untuk JSON, atau null kalau kosong
  local s="${1-}"
  [ -z "$s" ] && { printf 'null'; return; }
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/ }"; s="${s//$'\r'/ }"; s="${s//$'\t'/ }"
  # Sisa karakter kendali dibuang. apt dan journalctl kadang menyelipkan
  # karakter kendali di keluarannya - dan satu saja bikin seluruh baris JSON
  # tidak bisa diparse, termasuk baris log yang dibaca dashboard.
  s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037')
  printf '"%s"' "$s"
}

# Satu baris JSON per tindakan, bukan teks bebas. Dashboard tinggal parse,
# tidak perlu menebak formatnya - dan format teks bebas selalu berubah tanpa
# ada yang sadar sampai ada yang parsernya patah.
#
# Ditulis dua kali: ke berkas gabungan, dan ke berkas per kontrol. Yang kedua
# supaya "riwayat K05" tidak perlu menyaring satu berkas besar.
catat() {  # catat <status> <berhasil> <nilai> <pesan>
  [ -d "$LOG_DIR" ] || mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  local baris
  baris=$(printf '{"waktu":%s,"versi":%s,"pemanggil":%s,"id":%s,"tindakan":%s,"status":%s,"berhasil":%s,"nilai":%s,"pesan":%s}' \
    "$(kutip "$(date -Is)")" "$(kutip "$VERSI")" "$(kutip "${SUDO_USER:-?}")" \
    "$(kutip "${KID:-?}")" "$(kutip "${AKSI:-?}")" \
    "$(kutip "$1")" "${2:-false}" "$(kutip "${3-}")" "$(kutip "${4-}")")

  tulis_log "$LOG" "$baris"
  case "${KID:-}" in
    K[0-9][0-9]) tulis_log "$LOG_DIR/${KID}.log" "$baris" ;;
  esac
}

tulis_log() {  # tulis_log <berkas> <baris>
  # Dibuat dengan izin 640 sejak awal. Catatan tindakan alat keamanan tidak
  # perlu bisa dibaca semua pengguna di server itu.
  [ -e "$1" ] || { : > "$1" 2>/dev/null && chmod 640 "$1" 2>/dev/null; }
  printf '%s\n' "$2" >> "$1" 2>/dev/null || true
}

tolak() { KID="${KID:-?}"; AKSI="${AKSI:-?}"; selesai "DITOLAK" "false" "" "$1"; }

# ------------------------------------------------------- pemeriksaan diri
# Kalau skrip ini bisa ditulis selain root, agent tinggal menulis ulang
# isinya lalu menjalankannya lewat sudo - dan pembatasan sudoers jadi tidak
# ada gunanya sama sekali. Jadi diperiksa dulu sebelum melakukan apa pun.
aman_dari_tulis() {
  local p="$1" pemilik izin
  pemilik=$(stat -c '%U' "$p" 2>/dev/null) || return 1
  izin=$(stat -c '%a' "$p" 2>/dev/null) || return 1
  [ "$pemilik" = "root" ] || return 1
  (( (8#$izin & 8#022) == 0 )) || return 1
  return 0
}

periksa_diri() {
  [ "$(id -u)" -eq 0 ] || tolak "harus dijalankan sebagai root lewat sudo"
  local diri; diri="$(readlink -f "$0")"
  local d
  for d in "$diri" "$(dirname "$diri")" /opt/yoru; do
    [ -e "$d" ] || continue
    aman_dari_tulis "$d" || tolak "berhenti: $d bisa ditulis selain root"
  done
}

# ------------------------------------------------------------- alat bantu
# /run/sshd itu folder pemisahan hak milik sshd. Tanpa dia, "sshd -T" dan
# "sshd -t" MENOLAK JALAN - bukan karena openssh-server tidak ada, tapi karena
# folder itu belum dibuat.
#
# Dan di Ubuntu 24.04 dia memang sering belum ada. SSH di sana dinyalakan lewat
# ssh.socket, sedangkan yang membuat /run/sshd itu ssh.service lewat
# RuntimeDirectory=sshd - dan ssh.service baru jalan setelah ada yang benar-
# benar menyambung. Jadi di server yang baru boot dan belum ada yang login SSH,
# folder ini tidak ada, dan K01 sampai K05 jadi ERROR semua padahal sshd-nya
# terpasang dan sehat. systemd juga menghapusnya lagi saat ssh.service berhenti.
#
# Izinnya disamakan persis dengan yang dipasang systemd (RuntimeDirectoryMode
# 0755, milik root).
siapkan_run_sshd() {
  [ -d /run/sshd ] && return 0
  command -v sshd >/dev/null 2>&1 || return 1
  mkdir -p /run/sshd 2>/dev/null || return 1
  chown root:root /run/sshd 2>/dev/null
  chmod 0755 /run/sshd 2>/dev/null
}

# Alasan sebenarnya kenapa sshd -T gagal, bukan tebakan kita. Cuma dipanggil di
# jalur gagal, jadi tidak menambah kerja di jalur normal.
#
# Versi sebelumnya membuang stderr lalu menebak "openssh-server terpasang?" -
# dan tebakan itu salah di kasus paling sering, sehingga orang mencopot-pasang
# openssh-server berkali-kali untuk masalah yang sama sekali bukan itu.
alasan_sshd() {
  command -v sshd >/dev/null 2>&1 || {
    printf 'sshd tidak ada - openssh-server belum terpasang'; return 0; }
  local pesan
  pesan=$(sshd -T 2>&1 >/dev/null | tr '\n' ' ')
  pesan=$(printf '%s' "$pesan" | sed 's/  */ /g; s/^ //; s/ *$//' | cut -c1-180)
  [ -n "$pesan" ] || pesan='sshd -T gagal tanpa pesan apa pun'
  printf '%s' "$pesan"
}

# Sama dengan pastikan_terbaca, tapi khusus sshd: pesannya menyebut alasan
# aslinya dari sshd sendiri.
pastikan_sshd_terbaca() {  # pastikan_sshd_terbaca <nilai>
  local v="${1//\//}"
  [ -n "$v" ] || selesai ERROR false "$1" "sshd -T gagal: $(alasan_sshd)"
}

tulis_ssh() {  # tulis_ssh <namafile> <isi>
  printf '%s\n' "$2" > "/etc/ssh/sshd_config.d/$1" || return 1
  chmod 644 "/etc/ssh/sshd_config.d/$1"
  sshd -t 2>/dev/null || { rm -f "/etc/ssh/sshd_config.d/$1"; return 2; }
  systemctl reload ssh
}

hapus_ssh() {
  rm -f "/etc/ssh/sshd_config.d/$1"
  sshd -t 2>/dev/null || return 2
  systemctl reload ssh
}

sshd_nilai() { sshd -T 2>/dev/null | awk -v k="^$1\$" '$1 ~ k {print $2; exit}'; }

# Cari teks di keluaran sebuah perintah, tanpa pipa.
#
# JANGAN diubah jadi "perintah | grep -q teks". Skrip ini pakai pipefail, dan
# grep -q berhenti begitu ketemu lalu menutup pipa; perintah di depannya mati
# kena SIGPIPE (141) dan pipefail membacanya sebagai gagal. Jadi pencarian
# yang BERHASIL malah terbaca gagal. Ini yang bikin prasyarat K02 tidak
# pernah lolos sejak hari pertama - lihat catalog/K02.yaml.
#
# Cocoknya harfiah seperti grep -F, bukan regex. Pola di sini ada yang pakai
# kurung dan titik ("deny (incoming)", "0.0.0.0:3306") yang artinya berubah
# kalau dibaca sebagai regex.
ada_teks() {  # ada_teks <teks-harfiah> <perintah...>
  local teks="$1"; shift
  local keluaran
  keluaran=$("$@" 2>/dev/null) || true
  [[ "$keluaran" == *"$teks"* ]]
}

# Pasang paket tanpa menyerah pada hal yang wajar, dan tanpa mengarang alasan
# kalau gagal:
#   - paket yang sudah terpasang tidak memanggil apt sama sekali
#   - DPkg::Lock::Timeout bikin apt MENUNGGU kunci, bukan langsung gagal.
#     Di VPS yang baru nyala, apt-daily jalan di menit-menit pertama - tepat
#     saat Yoru mulai kerja.
#   - keluhan apt ditangkap, bukan dibuang
#
# Versi lama membuang keluaran apt lalu melapor "periksa koneksi internet"
# tanpa pernah memeriksa koneksi apa pun. Menebak penyebab lalu menulisnya
# seolah hasil pemeriksaan itu yang kita larang untuk agent - jangan sampai
# ada di kode sendiri.
apt_kesalahan=""
pasang_paket() {  # pasang_paket <nama-paket>
  local paket="$1" status keluaran
  apt_kesalahan=""
  status=$(dpkg-query -W -f='${Status}' "$paket" 2>/dev/null) || status=""
  [ "$status" = "install ok installed" ] && return 0
  keluaran=$(DEBIAN_FRONTEND=noninteractive apt-get -y \
               -o DPkg::Lock::Timeout=60 install "$paket" 2>&1) && return 0
  apt_kesalahan=$(printf '%s' "$keluaran" | tail -2 | tr '\n' ' ')
  return 1
}

# Hasil kosong bukan kesimpulan, itu pertanyaan. Kalau alat pemeriksanya tidak
# bisa dibaca sama sekali, statusnya ERROR - bukan GAGAL. Agent yang membaca
# GAGAL akan mencoba menerapkan kontrol, padahal kita belum tahu keadaannya.
pastikan_terbaca() {  # pastikan_terbaca <nilai> <pesan>
  local v="${1//\//}"
  [ -n "$v" ] || selesai ERROR false "$1" "$2"
}

# --------------------------------------------------------- prasyarat keras
# Dicek lagi di sini walaupun agent sudah mengeceknya. Agent bilang "sudah
# saya cek" itu janji, bukan jaminan keamanan.
ada_user_sudo_lain() {
  local u anggota
  anggota=$(getent group sudo | cut -d: -f4 | tr ',' ' ')
  for u in $anggota; do
    [ "$u" = "root" ] && continue
    local shell status
    shell=$(getent passwd "$u" | cut -d: -f7)
    case "$shell" in */nologin|*/false|"") continue ;; esac
    status=$(passwd -S "$u" 2>/dev/null | awk '{print $2}')
    [ "$status" = "P" ] || [ "$status" = "PS" ] || continue
    return 0
  done
  return 1
}

# Siapa "pemilik server" - yaitu manusia yang kunci SSH-nya harus sudah
# terbukti bekerja sebelum K02 boleh mematikan login password.
# Dibaca dari berkas milik root. SUDO_USER TIDAK dipakai sebagai sumber utama
# karena agent berjalan sebagai yoru-agent, yang memang tidak punya kunci.
pemilik_server() {
  local u=""
  [ -r /etc/yoru/pemilik ] && u=$(head -1 /etc/yoru/pemilik 2>/dev/null | tr -dc 'a-z0-9_-')
  [ -n "$u" ] || u="${SUDO_USER:-}"
  printf '%s' "$u"
}

kunci_ssh_terbukti() {
  local u; u="$(pemilik_server)"
  [ -n "$u" ] || return 1
  getent passwd "$u" >/dev/null || return 1
  local rumah; rumah=$(getent passwd "$u" | cut -d: -f6)
  [ -s "$rumah/.ssh/authorized_keys" ] || return 1
  ada_teks "Accepted publickey for $u" journalctl -t sshd --since "-30 days" \
    || return 1
  return 0
}

# ---------------------------------------------------- semua penghuni server
# Pemilik bukan satu-satunya orang di server. Kalau ada lima akun dan cuma
# pemilik yang punya kunci SSH, mematikan login password bikin empat orang
# terkunci di luar - dan Yoru akan melapor LULUS. Kontrol yang bikin orang
# kehilangan akses tidak boleh dihitung berhasil.

# Ambil SELURUH nilai sebuah setelan sshd, bukan cuma kata pertama.
# allowusers/denyusers isinya bisa banyak nama, sedangkan sshd_nilai berhenti
# di kata pertama. Dikerjakan pada salinan $0 - mengubah $1 langsung bikin
# awk menyusun ulang barisnya, dan itu pernah merusak pembacaan kami.
sshd_nilai_semua() {
  sshd -T 2>/dev/null | awk -v k="^$1\$" '$1 ~ k { s=$0; sub(/^[^ ]+[ ]+/, "", s); print s; exit }'
}

# Apakah <nama> ada di <daftar> yang dipisah spasi? Dicocokkan per kata,
# bukan substring - "budi" tidak boleh dianggap cocok dengan "budianto".
daftar_memuat() {
  local daftar=" $1 " nama="$2"
  case "$daftar" in *" $nama "*) return 0 ;; esac
  return 1
}

# Isinya nama biasa semua, tanpa pola? AllowUsers boleh diisi "bu*" atau
# "budi@1.2.3.4". Mencocokkan pola secara harfiah bisa MELEWATKAN orang yang
# sebenarnya bisa masuk - dan yang terlewat itulah yang terkunci. Jadi kalau
# ada pola, setelannya diabaikan dan semua akun ikut diperiksa: K02 jadi
# lebih cerewet, bukan lebih longgar.
daftar_polos() {
  local x
  for x in $1; do
    case "$x" in *[!a-zA-Z0-9_.-]*) return 1 ;; esac
  done
  return 0
}

# Siapa saja yang masih bisa masuk lewat SSH tapi BELUM punya kunci.
user_tanpa_kunci() {
  local izin tolak_ada root_boleh pakai_izin=0 pakai_tolak=0
  izin=$(sshd_nilai_semua allowusers)
  tolak_ada=$(sshd_nilai_semua denyusers)
  root_boleh=$(sshd_nilai permitrootlogin)

  if [ -n "$izin" ] && daftar_polos "$izin"; then pakai_izin=1; fi
  if [ -n "$tolak_ada" ] && daftar_polos "$tolak_ada"; then pakai_tolak=1; fi

  # AllowGroups/DenyGroups sengaja tidak dibaca. Keduanya hanya MEMPERSEMPIT
  # siapa yang boleh masuk, jadi mengabaikannya membuat daftar ini kepanjangan
  # - tidak pernah kependekan. Salah ke arah yang aman.

  local nama uid rumah shell
  while IFS=: read -r nama _ uid _ _ rumah shell; do
    # Akun layanan tidak bisa login sama sekali.
    case "$shell" in *nologin|*false|"") continue ;; esac

    if [ "$uid" = "0" ]; then
      # root cuma dihitung kalau dia memang masih masuk pakai password.
      # Kalau permitrootlogin sudah "no" atau "prohibit-password", K02 tidak
      # mengubah apa pun untuk root - menyebutnya cuma bikin gaduh.
      [ "$root_boleh" = "yes" ] || continue
    else
      [ "$uid" -ge 1000 ]  2>/dev/null || continue
      [ "$uid" -lt 65534 ] 2>/dev/null || continue
    fi

    if [ "$pakai_izin" = 1 ]  && ! daftar_memuat "$izin" "$nama";     then continue; fi
    if [ "$pakai_tolak" = 1 ] &&   daftar_memuat "$tolak_ada" "$nama"; then continue; fi

    [ -s "$rumah/.ssh/authorized_keys" ] || printf '%s\n' "$nama"
  done < <(getent passwd)
}

# -------------------------------------------------- rekam keadaan asal
# Sebelum sebuah kontrol diterapkan PERTAMA KALI di server ini, salin dulu
# berkas yang bakal disentuh dan bacaan keadaan yang sedang berlaku.
#
# Kenapa perlu: "kembalikan" di katalog memulihkan ke nilai BAWAAN yang kami
# tulis, bukan ke nilai asli server itu. Di server yang bawaannya beda, itu
# dua hal yang berbeda. Rekaman ini yang nanti menutup jarak tersebut.
#
# Disimpan sebagai berkas, bukan database. Rollback justru paling dibutuhkan
# saat servernya lagi bermasalah - dan database itu satu lagi hal yang bisa
# ikut mati. Berkas di disk tetap kebaca walau cuma punya shell darurat.

berkas_kontrol() {  # berkas yang disentuh tiap kontrol
  case "$1" in
    K01|K02|K03|K04) printf '%s\n' /etc/ssh/sshd_config /etc/ssh/sshd_config.d ;;
    K05)             printf '%s\n' /etc/default/ufw /etc/ufw ;;
    K06)             printf '%s\n' /etc/mysql/mariadb.conf.d ;;
    K07)             printf '%s\n' /etc/apt/apt.conf.d ;;
    K08)             printf '%s\n' /etc/audit/rules.d /etc/audit/auditd.conf ;;
    K09)             printf '%s\n' /etc/systemd/journald.conf /etc/systemd/journald.conf.d ;;
    K10)             printf '%s\n' /etc/sysctl.conf /etc/sysctl.d /etc/default/ufw ;;
  esac
}

# Bacaan keadaan yang SEDANG berlaku - bukan isi berkas, tapi apa yang
# benar-benar aktif. Untuk K10 ini yang paling penting: berkasnya bisa
# dihapus tanpa mengubah nilai yang dipegang kernel.
baca_efektif() {
  case "$KID" in
    K01) sshd_nilai permitrootlogin ;;
    K02) sshd_nilai passwordauthentication ;;
    K03) printf '%s/%s' "$(sshd_nilai maxauthtries)" "$(sshd_nilai logingracetime)" ;;
    K04) printf 'mac_sha1=%s' "$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1')" ;;
    K05) ufw status 2>/dev/null | awk '/^Status:/ {print $2}' ;;
    K06) ss -tulpn 2>/dev/null | grep -o '[0-9.]*:3306' | head -1 ;;
    K07) systemctl is-enabled unattended-upgrades 2>/dev/null ;;
    K08) printf 'aturan=%s' "$(auditctl -l 2>/dev/null | grep -c '^-w')" ;;
    K09) k09_max ;;
    K10) k10_baca ;;
  esac
}

# Sekali seumur server, tidak pernah ditimpa. Rekaman PERTAMA itu yang
# benar-benar "sebelum Yoru" - rekaman kedua cuma memotret hasil kerja kita
# sendiri.
rekam_asal() {
  local dir="$DIR_ASAL/$KID"
  [ -e "$dir/tercatat" ] && return 0

  mkdir -p "$dir/berkas" 2>/dev/null || return 1
  chmod 700 "$DIR_ASAL" "$dir" 2>/dev/null

  local f
  while read -r f; do
    [ -e "$f" ] || continue
    cp -a --parents "$f" "$dir/berkas/" 2>/dev/null
  done < <(berkas_kontrol "$KID")

  printf '{"id":%s,"waktu":%s,"nilai_sebelum":%s,"versi_yoru":%s}\n' \
    "$(kutip "$KID")" "$(kutip "$(date -Is)")" \
    "$(kutip "$(baca_efektif)")" "$(kutip "$VERSI")" \
    > "$dir/keadaan.json" 2>/dev/null || return 1
  chmod 600 "$dir/keadaan.json" 2>/dev/null

  date -Is > "$dir/tercatat" 2>/dev/null || return 1
  return 0
}

# ------------------------------------------------------------- 10 kontrol
k01() { case "$1" in
  periksa|verifikasi) nilai=$(sshd_nilai permitrootlogin)
    pastikan_sshd_terbaca "$nilai"
    [ "$nilai" = "no" ] && selesai LULUS true "$nilai" || selesai GAGAL true "$nilai" ;;
  terapkan)
    berkas_sama "/etc/ssh/sshd_config.d/01-yoru-k01.conf" "$K01_ISI" && [ "$(sshd_nilai permitrootlogin)" = "no" ] \
      && selesai DILEWATI true "no" "sudah diterapkan - sshd tidak di-reload lagi"
    ada_user_sudo_lain || tolak "tidak ada user sudo lain yang aktif - menerapkan ini mengunci pemilik"
    tulis_ssh 01-yoru-k01.conf "PermitRootLogin no" || tolak "sshd menolak konfigurasi"
    nilai=$(sshd_nilai permitrootlogin)
    [ "$nilai" = "no" ] && selesai LULUS true "$nilai" || { hapus_ssh 01-yoru-k01.conf; tolak "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) hapus_ssh 01-yoru-k01.conf; selesai DIKEMBALIKAN true "$(sshd_nilai permitrootlogin)" ;;
esac }

k02() { local kurang; case "$1" in
  periksa|verifikasi) nilai=$(sshd_nilai passwordauthentication)
    pastikan_sshd_terbaca "$nilai"
    [ "$nilai" = "no" ] && selesai LULUS true "$nilai" || selesai GAGAL true "$nilai" ;;
  terapkan)
    berkas_sama "/etc/ssh/sshd_config.d/01-yoru-k02.conf" "$K02_ISI" && [ "$(sshd_nilai passwordauthentication)" = "no" ] \
      && selesai DILEWATI true "no" "sudah diterapkan - sshd tidak di-reload lagi"
    kunci_ssh_terbukti || tolak "belum ada bukti login SSH key berhasil - menerapkan ini menutup satu-satunya jalan masuk"

    # Pemilik aman belum berarti semua orang aman. Tanpa langkah ini, K02
    # bisa mengunci penghuni lain di luar dan tetap melapor LULUS.
    kurang=$(user_tanpa_kunci)
    kurang="${kurang//$'\n'/ }"; kurang="${kurang% }"
    if [ -n "$kurang" ]; then
      if [ "$PAKSA" = "1" ]
        then catat "PERINGATAN" "true" "" "--paksa dipakai, akun tanpa kunci SSH ikut terkunci: $kurang"
        else tolak "akun ini belum punya kunci SSH dan akan terkunci di luar: $kurang - pasangi kunci dulu, atau ulangi dengan --paksa kalau akun itu memang sudah tidak dipakai"
      fi
    fi

    tulis_ssh 01-yoru-k02.conf "PasswordAuthentication no" || tolak "sshd menolak konfigurasi"
    nilai=$(sshd_nilai passwordauthentication)
    [ "$nilai" = "no" ] && selesai LULUS true "$nilai" || { hapus_ssh 01-yoru-k02.conf; tolak "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) hapus_ssh 01-yoru-k02.conf; selesai DIKEMBALIKAN true "$(sshd_nilai passwordauthentication)" ;;
esac }

k03() { case "$1" in
  periksa|verifikasi) nilai="$(sshd_nilai maxauthtries)/$(sshd_nilai logingracetime)"
    pastikan_sshd_terbaca "$nilai"
    [ "$nilai" = "3/30" ] && selesai LULUS true "$nilai" || selesai GAGAL true "$nilai" ;;
  terapkan)
    berkas_sama "/etc/ssh/sshd_config.d/01-yoru-k03.conf" "$K03_ISI" && [ "$(sshd_nilai maxauthtries)/$(sshd_nilai logingracetime)" = "3/30" ] \
      && selesai DILEWATI true "3/30" "sudah diterapkan - sshd tidak di-reload lagi"
    tulis_ssh 01-yoru-k03.conf "MaxAuthTries 3
LoginGraceTime 30" || tolak "sshd menolak konfigurasi"
    nilai="$(sshd_nilai maxauthtries)/$(sshd_nilai logingracetime)"
    [ "$nilai" = "3/30" ] && selesai LULUS true "$nilai" || { hapus_ssh 01-yoru-k03.conf; tolak "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) hapus_ssh 01-yoru-k03.conf; selesai DIKEMBALIKAN true "$(sshd_nilai maxauthtries)/$(sshd_nilai logingracetime)" ;;
esac }

K04_ISI="Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512"

k04() { local lemah; case "$1" in
  periksa|verifikasi)
    sshd -T >/dev/null 2>&1 || selesai ERROR false "" "sshd -T gagal: $(alasan_sshd)"
    lemah=$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1'); nilai="mac_sha1=$lemah"
    [ "$lemah" = "0" ] && selesai LULUS true "$nilai" || selesai GAGAL true "$nilai" ;;
  terapkan)
    berkas_sama "/etc/ssh/sshd_config.d/01-yoru-k04.conf" "$K04_ISI" && [ "$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1')" = "0" ] \
      && selesai DILEWATI true "mac_sha1=0" "sudah diterapkan - sshd tidak di-reload lagi"
    tulis_ssh 01-yoru-k04.conf "$K04_ISI" || tolak "sshd menolak daftar algoritma"
    lemah=$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1'); nilai="mac_sha1=$lemah"
    [ "$lemah" = "0" ] && selesai LULUS true "$nilai" || { hapus_ssh 01-yoru-k04.conf; tolak "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) hapus_ssh 01-yoru-k04.conf
    selesai DIKEMBALIKAN true "mac_sha1=$(sshd -T 2>/dev/null | grep -E '^macs ' | grep -c 'sha1')" ;;
esac }

# Port SSH dibaca dari sshd sendiri, tidak dipatok 22.
#
# Penyedia VPS sering memindahkannya - CloudBaik memakai 4422. Kalau dipatok,
# K05 menolak jalan di server itu, dan kontrol yang tidak pernah bisa jalan
# sama saja dengan tidak ada. Penolakannya pun terdengar wajar ("sshd tidak
# terdeteksi di port 22"), jadi tidak ada yang curiga.
#
# sshd -T mencetak satu baris "port <n>" per port yang dipakai, jadi server
# yang mendengar di dua port ikut tertangani.
port_ssh() { sshd -T 2>/dev/null | awk '/^port /{print $2}'; }

# ------------------------------------------------------------ idempotensi
# Memanggil terapkan berkali-kali tidak boleh mengulang perubahan.
# Yang paling terasa di K06: tiap panggilan me-restart mariadb, jadi dua
# panggilan = koneksi database putus dua kali. Hasil akhirnya sama, tapi
# gangguannya nyata.
#
# Syaratnya DUA, bukan satu, dan ini penting:
#
#   1. berkas milik Yoru sudah ada DENGAN ISI YANG SAMA PERSIS, dan
#   2. keadaan efektifnya memang sudah sesuai
#
# Kalau syaratnya cuma nomor 2 ("nilainya sudah benar, lewati"), muncul
# lubang halus: nilai itu bisa datang dari berkas milik orang lain. Kalau
# suatu hari berkas itu hilang, setelannya balik berbahaya tanpa ada yang
# tahu, karena Yoru merasa sudah beres. Dengan syarat nomor 1, Yoru tetap
# menuliskan berkasnya sendiri dulu - dia jadi PEMILIK setelan itu - dan
# baru setelah itu boleh melewati.
#
# Satu setelan, satu pemilik. Pelajaran dari ufw dan sysctl di K10.
berkas_sama() {  # berkas_sama <berkas> <isi-yang-diharapkan>
  [ -f "$1" ] || return 1
  [ "$(cat "$1" 2>/dev/null)" = "$2" ]
}

K01_ISI="PermitRootLogin no"
K02_ISI="PasswordAuthentication no"
K03_ISI="MaxAuthTries 3
LoginGraceTime 30"
K06_ISI="[mysqld]
bind-address = 127.0.0.1"
K09_ISI="[Journal]
Storage=persistent
Compress=yes
SystemMaxUse=500M
SystemKeepFree=1G
MaxRetentionSec=1month"

# ------------------------------------------------- port layanan lain
# SSH bukan satu-satunya pintu. Server orang biasanya juga punya web, panel
# (aaPanel, CyberPanel), atau layanan lain. Menyalakan firewall tolak-semua
# tanpa mengurus port itu = mengunci pemilik di luar panelnya sendiri.
#
# Godaannya adalah menghafalkan nomornya: 8888 buat aaPanel, 8090 buat
# CyberPanel, 2083 buat cPanel. Itu kesalahan yang sama persis dengan
# mematok port SSH di 22, cuma dibungkus lebih rapi - orang bisa mengganti
# port panelnya, dan panel yang belum kami tahu ada ratusan.
#
# Jadi caranya sama seperti SSH: BACA KENYATAAN, jangan menebak.

# Semua port TCP yang benar-benar terbuka ke luar, berikut nama prosesnya.
#
# Alamat loopback dibuang - 127.x dan ::1 tidak bisa dihubungi dari internet,
# jadi bukan lubang. Kalau ikut didaftar, pemilik dihujani pertanyaan soal
# port yang memang aman, dan pertanyaan yang terasa mengada-ada adalah cara
# tercepat membuat orang berhenti membaca.
#
# UDP sengaja tidak diikutkan: yang bikin orang terkunci di luar itu TCP
# (ssh, web, panel). Memasukkan UDP cuma menambah keramaian seperti port
# klien DHCP. Ini lubang yang kami tahu, ditulis supaya tidak dikira lengkap.
port_publik() {
  local keluaran
  keluaran=$(ss -tlnp 2>/dev/null) || return 0
  printf '%s\n' "$keluaran" | awk '
    $1 != "LISTEN" { next }
    {
      alamat = $4
      port  = alamat; sub(/.*:/, "", port)
      induk = alamat; sub(/:[^:]*$/, "", induk)
      sub(/%.*$/, "", induk)            # "127.0.0.53%lo" -> "127.0.0.53"
      if (induk ~ /^127\./)  next
      if (induk == "[::1]")  next
      if (induk == "::1")    next
      proses = "?"
      if (match($0, /"[^"]+"/)) proses = substr($0, RSTART + 1, RLENGTH - 2)
      print port " " proses
    }' | sort -k1,1n -u
}

# Port yang sudah dijawab pemilik "iya, itu memang punya saya".
#
# Dua sumber, sengaja:
#   /etc/yoru/yoru.conf  PORT_DIIZINKAN="80 443"   <- root, agent tidak bisa menulis
#   /var/lib/yoru/port-disetujui                   <- ditulis agent dari jawaban pemilik
#
# Yang kedua memang bisa ditulis agent, dan itu disengaja: kalau pemilik harus
# SSH masuk lalu menyunting berkas sendiri, seluruh janji "buat yang tidak
# punya tim IT" bubar. Ini juga bukan pelebaran kekuasaan - agent sudah bisa
# memanggil "K05 kembalikan" yang mematikan firewall sepenuhnya, jadi
# menambah satu port izin itu justru lebih kecil dari yang sudah bisa dia
# lakukan. Yang tidak berubah: setiap port yang diizinkan ikut tercatat di
# jejak audit milik root, yang tidak bisa disunting agent.
#
# Yang mau lebih ketat tinggal memakai yoru.conf saja dan membiarkan berkas
# kedua kosong.
DIR_DATA=/var/lib/yoru
BERKAS_PORT="$DIR_DATA/port-disetujui"
KONF=/etc/yoru/yoru.conf

ambil_konf() {  # ambil_konf <kunci> - dibaca sebagai teks, TIDAK di-source
  [ -r "$KONF" ] || return 0
  awk -v k="$1" '
    {
      baris = $0
      sub(/^[[:space:]]+/, "", baris)
      if (baris ~ /^#/ || baris == "") next
      p = index(baris, "=")
      if (p == 0) next
      nama  = substr(baris, 1, p - 1)
      nilai = substr(baris, p + 1)
      sub(/[[:space:]]+$/, "", nama)
      sub(/^[[:space:]]+/, "", nilai); sub(/[[:space:]]+$/, "", nilai)
      gsub(/^"|"$/, "", nilai)
      if (nama == k) { print nilai; exit }
    }' "$KONF" 2>/dev/null
}

port_sah() {  # angka saja, 1-65535
  case "$1" in ""|*[!0-9]*) return 1 ;; esac
  [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

port_disetujui() {
  local hasil="" p baris
  for p in $(ambil_konf PORT_DIIZINKAN); do
    port_sah "$p" && hasil="$hasil $p"
  done
  if [ -r "$BERKAS_PORT" ]; then
    while read -r baris || [ -n "$baris" ]; do
      baris="${baris%%#*}"                 # buang keterangan
      baris="${baris//[[:space:]]/}"
      port_sah "$baris" && hasil="$hasil $baris"
    done < "$BERKAS_PORT"
  fi
  printf '%s' "${hasil# }"
}

# Firewall lain yang aktif di server yang sama.
#
# Dua firewall bukan konfigurasi - itu lomba lari, dan pemenangnya berubah
# tergantung urutan start layanan. Persis pelajaran dari K10 dan ufw soal
# log_martians, cuma skalanya seluruh tabel aturan.
#
# Yang diperiksa cuma CSF dan firewalld: dua-duanya tidak ada di Ubuntu
# bawaan, jadi kalau ketemu artinya memang sengaja dipasang. nftables belum
# diperiksa karena ufw sendiri memakainya sebagai mesin di belakang layar,
# dan kami belum menguji cara membedakan "nftables punya ufw" dengan
# "nftables punya pemilik". Ditulis supaya tidak dikira sudah lengkap.
firewall_lain() {
  if command -v csf >/dev/null 2>&1 || [ -f /etc/csf/csf.conf ]; then
    printf 'CSF (biasanya bawaan cPanel)'; return 0
  fi
  if [ "$(systemctl is-active firewalld 2>/dev/null)" = "active" ]; then
    printf 'firewalld'; return 0
  fi
  return 1
}

# Port terbuka yang belum dijawab pemilik dan bukan port SSH.
port_belum_dijawab() {  # port_belum_dijawab "<port-ssh>" "<port-disetujui>"
  local ssh_port="$1" oke="$2" belum="" p proses
  while read -r p proses; do
    [ -n "$p" ] || continue
    daftar_memuat "$ssh_port" "$p" && continue
    daftar_memuat "$oke" "$p"      && continue
    belum="$belum $p($proses)"
  done < <(port_publik)
  printf '%s' "${belum# }"
}

k05() { local p daftar ada oke belum lain; case "$1" in
  periksa|verifikasi)
    command -v ufw >/dev/null 2>&1 || selesai ERROR false "" "ufw tidak terpasang - tidak bisa diperiksa"

    # Daftar port yang belum dijawab pemilik ikut dikirim di "pesan". Ini
    # bahan mentah buat Hermes menyusun pertanyaan ke pemilik: "port 8888
    # terbuka dipakai python3, itu panel kamu?" - dan jawabannya nanti yang
    # bikin terapkan bisa jalan.
    belum="$(port_belum_dijawab "$(port_ssh)" "$(port_disetujui)")"
    [ -z "$belum" ] || belum="port terbuka belum dijawab pemilik: $belum"

    nilai=$(ufw status verbose 2>/dev/null | awk '/^Status:/ {print $2}')
    if [ "$nilai" = "active" ] && ada_teks 'deny (incoming)' ufw status verbose
      then selesai LULUS true "$nilai" "$belum"
      else selesai GAGAL true "${nilai:-tidak-aktif}" "$belum"; fi ;;
  terapkan)
    # Tanpa penjaga ini, semua perintah ufw gagal diam-diam (keluarannya
    # dibuang), lalu status kosong terbaca sebagai "ufw gagal aktif" - sebab
    # yang salah, persis kesalahan yang pernah kita kena di K07.
    command -v ufw >/dev/null 2>&1 || tolak "ufw tidak terpasang - pasang dulu: apt-get install ufw"

    lain="$(firewall_lain)" && tolak "server ini sudah memakai $lain - dua firewall akan saling menimpa aturan. Yoru tidak menyalakan ufw di sini"

    daftar="$(port_ssh)"
    [ -n "$daftar" ] || tolak "tidak bisa membaca port SSH: $(alasan_sshd)"

    # Port harus benar-benar didengar, bukan sekadar tertulis di konfigurasi.
    # Menyalakan firewall berdasarkan niat, bukan kenyataan, itu cara mengunci
    # diri sendiri di luar server.
    ada=0
    for p in $daftar; do ada_teks ":$p " ss -tulpn && ada=1; done
    [ "$ada" = "1" ] || tolak "sshd tidak terdengar di port mana pun dari daftar: $(printf '%s ' $daftar)"

    # Layanan lain yang terbuka tapi belum dijawab pemilik. Yoru tidak tahu
    # 8888 itu panel atau lubang - yang tahu cuma pemiliknya. Jadi berhenti
    # di sini dan tanya, JANGAN tebak. Mengizinkan otomatis = firewallnya
    # tidak ada gunanya; membiarkan tertutup = pemilik terkunci dari panelnya.
    oke="$(port_disetujui)"
    belum="$(port_belum_dijawab "$daftar" "$oke")"
    [ -z "$belum" ] || tolak "port ini terbuka tapi belum dijawab pemilik: $belum - tanyakan dulu, lalu catat portnya di $BERKAS_PORT atau PORT_DIIZINKAN di $KONF"

    # Diizinkan SEBELUM firewall dinyalakan. Urutan terbalik = terkunci.
    for p in $daftar; do
      ufw allow "$p"/tcp comment 'SSH - yoru K05' >/dev/null 2>&1
    done
    for p in $oke; do
      ufw allow "$p"/tcp comment 'disetujui pemilik - yoru K05' >/dev/null 2>&1
    done
    [ -z "$oke" ] || catat "PERINGATAN" "true" "" "port disetujui pemilik ikut diizinkan: $oke"

    ufw default deny incoming  >/dev/null 2>&1
    ufw default allow outgoing >/dev/null 2>&1
    ufw --force enable         >/dev/null 2>&1
    nilai=$(ufw status 2>/dev/null | awk '/^Status:/ {print $2}')
    [ "$nilai" = "active" ] && selesai LULUS true "$nilai" || tolak "ufw gagal aktif" ;;
  kembalikan)
    # Kalau ufw memang tidak ada, tidak ada yang perlu dikembalikan. Melapor
    # DIKEMBALIKAN dengan nilai kosong itu kabar bohong yang terdengar sukses.
    command -v ufw >/dev/null 2>&1 || selesai DILEWATI true "ufw tidak terpasang"
    ufw --force reset >/dev/null 2>&1
    selesai DIKEMBALIKAN true "$(ufw status 2>/dev/null | awk '/^Status:/ {print $2}')" ;;
esac }

K06_BERKAS=/etc/mysql/mariadb.conf.d/zz-yoru-k06.cnf
k06() { case "$1" in
  periksa|verifikasi)
    if ada_teks '0.0.0.0:3306' ss -tulpn; then nilai="0.0.0.0:3306"; selesai GAGAL true "$nilai"
    elif ada_teks '127.0.0.1:3306' ss -tulpn; then selesai LULUS true "127.0.0.1:3306"
    else selesai DILEWATI true "tidak ada layanan di 3306"; fi ;;
  terapkan)
    [ -d /etc/mysql/mariadb.conf.d ] || tolak "MariaDB tidak terpasang"
    # mariadb TIDAK di-restart kalau semuanya memang sudah benar
    berkas_sama "$K06_BERKAS" "$K06_ISI" && ada_teks '127.0.0.1:3306' ss -tulpn \
      && selesai DILEWATI true "127.0.0.1:3306" "sudah diterapkan - mariadb tidak direstart"
    printf '[mysqld]\nbind-address = 127.0.0.1\n' > "$K06_BERKAS"; chmod 644 "$K06_BERKAS"
    systemctl restart mariadb || { rm -f "$K06_BERKAS"; tolak "mariadb gagal start, sudah dikembalikan"; }
    sleep 2
    if ada_teks '127.0.0.1:3306' ss -tulpn
      then selesai LULUS true "127.0.0.1:3306"
      else rm -f "$K06_BERKAS"; systemctl restart mariadb; tolak "verifikasi gagal, sudah dikembalikan"; fi ;;
  kembalikan) rm -f "$K06_BERKAS"; systemctl restart mariadb; sleep 2
    selesai DIKEMBALIKAN true "$(ss -tulpn 2>/dev/null | grep -o '[0-9.]*:3306' | head -1)" ;;
esac }

k07() { case "$1" in
  periksa|verifikasi) nilai=$(systemctl is-enabled unattended-upgrades 2>/dev/null)
    [ "$nilai" = "enabled" ] && selesai LULUS true "$nilai" || selesai GAGAL true "${nilai:-tidak-terpasang}" ;;
  terapkan)
    pasang_paket unattended-upgrades \
      || tolak "gagal memasang unattended-upgrades. apt bilang: ${apt_kesalahan:-tidak ada keterangan}"
    printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' \
      > /etc/apt/apt.conf.d/20auto-upgrades
    systemctl enable --now unattended-upgrades >/dev/null 2>&1
    nilai=$(systemctl is-enabled unattended-upgrades 2>/dev/null)
    [ "$nilai" = "enabled" ] && selesai LULUS true "$nilai" || tolak "layanan tidak enabled setelah dipasang" ;;
  kembalikan) systemctl disable --now unattended-upgrades >/dev/null 2>&1
    selesai DIKEMBALIKAN true "$(systemctl is-enabled unattended-upgrades 2>/dev/null)" ;;
esac }

K08_BERKAS=/etc/audit/rules.d/zz-yoru-k08.rules
K08_ISI='# K08 - jejak audit Yoru
-w /etc/passwd -p wa -k identitas
-w /etc/shadow -p wa -k identitas
-w /etc/group -p wa -k identitas
-w /etc/gshadow -p wa -k identitas
-w /etc/sudoers -p wa -k hak_akses
-w /etc/sudoers.d/ -p wa -k hak_akses
-w /etc/ssh/sshd_config -p wa -k ssh_config
-w /etc/ssh/sshd_config.d/ -p wa -k ssh_config
-w /etc/ufw/ -p wa -k firewall
-w /etc/sysctl.d/99-yoru-k10.conf -p wa -k yoru_kontrol
-w /etc/systemd/journald.conf.d/99-yoru-k09.conf -p wa -k yoru_kontrol
-w /etc/mysql/mariadb.conf.d/zz-yoru-k06.cnf -p wa -k yoru_kontrol'

k08() { local n; case "$1" in
  periksa|verifikasi) n=$(auditctl -l 2>/dev/null | grep -c '^-w'); nilai="aturan=$n"
    [ "$n" -ge 12 ] && selesai LULUS true "$nilai" || selesai GAGAL true "$nilai" ;;
  terapkan)
    berkas_sama "$K08_BERKAS" "$K08_ISI" && [ "$(auditctl -l 2>/dev/null | grep -c '^-w')" -ge 12 ] 2>/dev/null \
      && selesai DILEWATI true "aturan=$(auditctl -l 2>/dev/null | grep -c '^-w')" "sudah diterapkan - aturan audit tidak dimuat ulang"
    if ! command -v auditctl >/dev/null 2>&1; then
      pasang_paket auditd \
        || tolak "gagal memasang auditd. apt bilang: ${apt_kesalahan:-tidak ada keterangan}"
    fi
    command -v auditctl >/dev/null 2>&1 || tolak "paket auditd terpasang tapi perintah auditctl tidak ditemukan"
    # awalan zz- wajib: audit.rules bawaan diawali -D yang menghapus semua
    # aturan, dan file bernama angka dimuat lebih dulu lalu ikut terhapus.
    printf '%s\n' "$K08_ISI" > "$K08_BERKAS"; chmod 640 "$K08_BERKAS"
    systemctl start auditd >/dev/null 2>&1
    augenrules --load >/dev/null 2>&1
    n=$(auditctl -l 2>/dev/null | grep -c '^-w'); nilai="aturan=$n"
    [ "$n" -ge 12 ] && selesai LULUS true "$nilai" || { rm -f "$K08_BERKAS"; augenrules --load >/dev/null 2>&1; tolak "aturan tidak termuat, sudah dikembalikan"; } ;;
  kembalikan) rm -f "$K08_BERKAS"; augenrules --load >/dev/null 2>&1
    selesai DIKEMBALIKAN true "aturan=$(auditctl -l 2>/dev/null | grep -c '^-w')" ;;
esac }

K09_BERKAS=/etc/systemd/journald.conf.d/99-yoru-k09.conf
# Satuan yang dicetak journald menyesuaikan besarnya - bisa M, bisa G di
# server berdisk besar. Pola lama hanya mengenali M, jadi di VPS besar
# pembacaannya kosong dan terbaca sebagai "tidak-terbaca" - hasil kosong
# dipakai sebagai kesimpulan, persis yang kita larang.
k09_max() { journalctl -b -t systemd-journald --no-pager 2>/dev/null | grep -oE 'max [0-9.]+[KMGT]' | tail -1; }
k09() { case "$1" in
  periksa|verifikasi) nilai=$(k09_max)
    journalctl --disk-usage >/dev/null 2>&1 || selesai ERROR false "" "journalctl tidak bisa dibaca"
    if [ -d /var/log/journal ] && [ "$nilai" = "max 500.0M" ]
      then selesai LULUS true "$nilai"; else selesai GAGAL true "${nilai:-tidak-terbaca}"; fi ;;
  terapkan)
    berkas_sama "$K09_BERKAS" "$K09_ISI" && [ -d /var/log/journal ] && [ "$(k09_max)" = "max 500.0M" ] \
      && selesai DILEWATI true "max 500.0M" "sudah diterapkan - journald tidak direstart"
    mkdir -p /etc/systemd/journald.conf.d
    printf '[Journal]\nStorage=persistent\nCompress=yes\nSystemMaxUse=500M\nSystemKeepFree=1G\nMaxRetentionSec=1month\n' > "$K09_BERKAS"
    chmod 644 "$K09_BERKAS"; systemctl restart systemd-journald; sleep 1
    nilai=$(k09_max)
    [ "$nilai" = "max 500.0M" ] && selesai LULUS true "$nilai" || { rm -f "$K09_BERKAS"; systemctl restart systemd-journald; tolak "verifikasi gagal, sudah dikembalikan"; } ;;
  kembalikan) rm -f "$K09_BERKAS"; systemctl restart systemd-journald; sleep 1
    selesai DIKEMBALIKAN true "$(k09_max)" ;;
esac }

K10_BERKAS=/etc/sysctl.d/99-yoru-k10.conf
K10_ISI='# K10 - setelan kernel jaringan (Yoru)
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1
net.ipv4.icmp_echo_ignore_broadcasts = 1
net.ipv4.icmp_ignore_bogus_error_responses = 1
net.ipv4.icmp_echo_ignore_all = 0
net.ipv4.tcp_syncookies = 1
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
net.ipv6.conf.all.accept_ra = 0
net.ipv6.conf.default.accept_ra = 0'

k10_baca() {
  local lm sr ra
  lm=$(sysctl -n net.ipv4.conf.all.log_martians    2>/dev/null)
  sr=$(sysctl -n net.ipv4.conf.all.secure_redirects 2>/dev/null)
  ra=$(sysctl -n net.ipv6.conf.all.accept_ra       2>/dev/null)
  # Server yang IPv6-nya dimatikan total tidak punya saklar ini sama sekali.
  # Itu bukan kegagalan - tidak ada IPv6 berarti tidak ada yang diamankan.
  # Tanpa penanganan ini K10 akan melapor GAGAL selamanya di VPS tanpa IPv6.
  [ -n "$ra" ] || ra="na"
  printf '%s/%s/%s' "${lm:-?}" "${sr:-?}" "$ra"
}
k10_lulus() { case "$1" in "1/0/0"|"1/0/na") return 0 ;; *) return 1 ;; esac; }
k10() { case "$1" in
  periksa|verifikasi) nilai=$(k10_baca)
    case "$nilai" in *'?'*) selesai ERROR false "$nilai" "sysctl ipv4 tidak bisa dibaca" ;; esac
    k10_lulus "$nilai" && selesai LULUS true "$nilai" || selesai GAGAL true "$nilai" ;;
  terapkan)
    berkas_sama "$K10_BERKAS" "$K10_ISI" && k10_lulus "$(k10_baca)" && ada_teks '#yoru-k10#IPT_SYSCTL=' cat /etc/default/ufw \
      && selesai DILEWATI true "$(k10_baca)" "sudah diterapkan - sysctl tidak dimuat ulang"
    printf '%s\n' "$K10_ISI" > "$K10_BERKAS"; chmod 644 "$K10_BERKAS"
    # ufw menerapkan sysctl-nya sendiri setiap start dan menimpa log_martians
    # jadi 0. Lepaskan ufw dari urusan sysctl supaya satu setelan punya satu
    # pemilik. Semua yang tadinya diatur ufw sudah tercakup di berkas ini.
    #
    # Penanda ditaruh di DEPAN dan tidak ada teks yang ditambahkan di belakang.
    # Nilai aslinya wajib tetap utuh, karena itulah satu-satunya bahan yang
    # dipunya kembalikan untuk memulihkan baris ini persis seperti semula.
    # Penjelasan panjangnya ada di catalog/K10.yaml.
    if grep -q '^IPT_SYSCTL=' /etc/default/ufw 2>/dev/null; then
      sed -i 's|^IPT_SYSCTL=|#yoru-k10#IPT_SYSCTL=|' /etc/default/ufw
    fi
    sysctl -p "$K10_BERKAS" >/dev/null 2>&1
    nilai=$(k10_baca)
    k10_lulus "$nilai" && selesai LULUS true "$nilai" || tolak "verifikasi gagal, nilai=$nilai" ;;
  kembalikan)
    # kernel menyimpan nilai terakhir - menghapus berkas saja TIDAK cukup
    rm -f "$K10_BERKAS"
    # Hanya membuka baris yang ditandai Yoru sendiri. Baris yang dikomentari
    # pemilik server atau distronya TIDAK disentuh - Yoru cuma membatalkan
    # perbuatannya sendiri, bukan menebak apa yang seharusnya aktif.
    sed -i 's|^#yoru-k10#IPT_SYSCTL=|IPT_SYSCTL=|' /etc/default/ufw 2>/dev/null
    sysctl -w net.ipv4.conf.all.log_martians=0 \
             -w net.ipv4.conf.default.log_martians=0 \
             -w net.ipv4.conf.all.secure_redirects=1 \
             -w net.ipv4.conf.default.secure_redirects=1 \
             -w net.ipv4.conf.default.accept_source_route=1 \
             -w net.ipv6.conf.all.accept_ra=1 \
             -w net.ipv6.conf.default.accept_ra=1 >/dev/null 2>&1
    selesai DIKEMBALIKAN true "$(k10_baca)" ;;
esac }

# ----------------------------------------------------------------- jalan
KID=""; AKSI=""; PAKSA=0
case $# in
  2) : ;;
  3) KID="?"; AKSI="?"
     [ "$3" = "--paksa" ] || tolak "pilihan tidak dikenal: $3"
     PAKSA=1 ;;
  *) KID="?"; AKSI="?"
     tolak "pakai: yoructl <K01..K10> <periksa|terapkan|kembalikan|verifikasi> [--paksa]" ;;
esac

KID="$1"; AKSI="$2"
[[ "$KID"  =~ ^K(0[1-9]|10)$ ]] || tolak "nomor kontrol tidak dikenal"
[[ "$AKSI" =~ ^(periksa|terapkan|kembalikan|verifikasi)$ ]] || tolak "tindakan tidak dikenal"

# --paksa itu keputusan MANUSIA, bukan keputusan agent.
#
# Baris sudoers tidak membatasi argumen, jadi secara teknis agent bisa saja
# mengetik --paksa sendiri. Yang mencegahnya harus di sini. Kalau tidak, satu
# baris log yang dirancang jahat bisa berujung agent memaksa K02 dan mengunci
# penghuni server di luar - persis skenario yang seluruh desain ini hindari.
AGEN=yoru-agent
if [ "$PAKSA" = "1" ] && [ "${SUDO_USER:-}" = "$AGEN" ]; then
  tolak "--paksa tidak boleh dipakai agent - ini keputusan manusia, jalankan sendiri lewat sudo"
fi

periksa_diri
siapkan_run_sshd

# Kunci hanya untuk tindakan yang MENULIS. periksa dan verifikasi cuma baca,
# jadi sengaja dibiarkan bebas: siklus penjagaan harian isinya periksa semua,
# dan tidak ada gunanya bikin dia antre di belakang penerapan yang panjang.
case "$AKSI" in
  terapkan|kembalikan)
    ambil_kunci
    case "$?" in
      1) tolak "kontrol lain sedang diterapkan atau dikembalikan - sudah menunggu ${TUNGGU_KUNCI} detik, coba lagi nanti" ;;
      2) catat "PERINGATAN" "true" "" "flock tidak tersedia - jalan tanpa kunci, jangan panggil dua tindakan sekaligus" ;;
    esac ;;
esac

# Rekam keadaan asal sebelum menyentuh apa pun. Cuma untuk terapkan - periksa
# dan verifikasi tidak mengubah apa-apa, dan kembalikan justru butuh rekaman
# yang sudah ada, bukan bikin baru.
#
# Kalau perekaman gagal, terapkan TETAP jalan tapi dicatat. Alasannya:
# kembalikan tetap berfungsi lewat resep di katalog, jadi ini bukan
# kehilangan rollback - cuma kehilangan kemampuan pulih ke nilai asli server
# ini. Yang tidak boleh adalah gagal diam-diam, lalu ada yang mengira
# cadangannya ada padahal tidak.
if [ "$AKSI" = "terapkan" ]; then
  if ! rekam_asal; then
    catat "PERINGATAN" "true" "" "keadaan asal gagal direkam ke $DIR_ASAL/$KID - terapkan tetap dilanjutkan"
  fi
fi

"$(printf 'k%02d' "$((10#${KID#K}))")" "$AKSI"
tolak "tindakan tidak tertangani"
