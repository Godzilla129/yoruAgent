#!/usr/bin/env python3
"""
yoru-agent - the brain.

Called daily by yoru-watch:
    yoru-agent --siklus penjagaan --konfigurasi /etc/yoru/yoru.conf

Four jobs:
  1. ask yoructl to check the ten controls
  2. assemble a report matching contract/report.md
  3. send it to the dashboard and collect the owner's answers
  4. apply what it is allowed to apply

ONE RULE SHAPES THIS ENTIRE FILE:

The agent NEVER assembles a shell command. The only way it touches the server
is by calling yoructl with two fixed arguments - a control number and an action
name. No command string is built from config, from the owner's answers, and
certainly not from a model's output. If someone is ever tempted to add
subprocess(shell=True) here, the whole reason Yoru can be trusted near
someone's server collapses.

AND ONE MORE:

The report must assemble with NO model at all. The sentences for the owner are
already written by humans in the catalog. A model adds a layer on top - work
ordering, judging suspicious ports, translating drift - but if the key expires
or the network is down, the report still comes out complete. Neither a demo
nor someone's server may depend on one API call that can fail.
"""

import argparse
import json
import os
import platform
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

CONTRACT_VERSION = "1"

YORUCTL = "/opt/yoru/bin/yoructl"
CATALOG_DIR = Path("/usr/share/yoru/catalog")
DATA_DIR = Path("/var/lib/yoru")
HISTORY_DIR = DATA_DIR / "riwayat"
REPORT_FILE = DATA_DIR / "laporan-terakhir.json"
PORT_FILE = DATA_DIR / "port-disetujui"

ALL_CONTROLS = [f"K{n:02d}" for n in range(1, 11)]

# Must match the catalog. If they drift apart, a risky control could run
# without approval - so when the catalog changes, change this too.
SAFE = {"K03", "K07", "K08", "K09", "K10"}

# yoructl -> contract. DITOLAK during a check means the request itself was
# wrong, not that the control failed, so it maps to ERROR.
STATUS_MAP = {
    "LULUS": "LULUS",
    "GAGAL": "GAGAL",
    "DILEWATI": "DILEWATI",
    "DIKEMBALIKAN": "DILEWATI",
    "DITOLAK": "ERROR",
    "ERROR": "ERROR",
    "PERINGATAN": "ERROR",
}


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def say(*a):
    print("[yoru-agent]", *a, file=sys.stderr, flush=True)


# --------------------------------------------------------------------- config
def read_config(path):
    """Read as TEXT, never executed.

    The tempting shortcut is `source` or `exec` because it is shorter. That
    turns the config file into a place to put commands - one line there runs as
    root, and nothing inspects it.
    """
    config = {}
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return config
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
        config[key.strip()] = val
    return config


def read_catalog():
    """The facts for each control. The agent may not invent anything beyond it."""
    try:
        import yaml
    except ImportError:
        say("PyYAML tidak ada - pasang dengan: apt-get install -y python3-yaml")
        return {}

    catalog = {}
    for kid in ALL_CONTROLS:
        path = CATALOG_DIR / f"{kid}.yaml"
        try:
            catalog[kid] = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        except Exception as e:  # noqa: BLE001
            say(f"katalog {kid} tidak terbaca: {e}")
            catalog[kid] = {}
    return catalog


def tidy(text):
    """YAML folded blocks leave stray newlines and double spaces behind."""
    if not text:
        return ""
    return re.sub(r"\s+", " ", str(text)).strip()


# ------------------------------------------------------------------ execution
def call_yoructl(kid, action, timeout=180):
    """One program, two arguments. No shell, no assembled strings."""
    if kid not in ALL_CONTROLS or action not in {
        "periksa", "terapkan", "kembalikan", "verifikasi"
    }:
        return {"status": "ERROR", "berhasil": False,
                "pesan": "kontrol atau tindakan tidak dikenal", "nilai": None}

    cmd = ["sudo", "-n", YORUCTL, kid, action]
    if os.geteuid() == 0:
        cmd = [YORUCTL, kid, action]

    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"status": "ERROR", "berhasil": False, "nilai": None,
                "pesan": f"yoructl {kid} {action} lewat batas {timeout} detik"}
    except OSError as e:
        return {"status": "ERROR", "berhasil": False, "nilai": None,
                "pesan": f"tidak bisa memanggil yoructl: {e}"}

    # yoructl always prints one JSON line as the last line of stdout.
    for line in reversed([b for b in p.stdout.splitlines() if b.strip()]):
        try:
            return json.loads(line)
        except json.JSONDecodeError:
            continue

    return {"status": "ERROR", "berhasil": False, "nilai": None,
            "pesan": (p.stderr or "yoructl tidak mengeluarkan JSON").strip()[:300]}


def run_output(cmd, timeout=10):
    """Read one command's output. Argument list, never a shell string."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


# ---------------------------------------------------------------- server info
def detect_panel():
    for path, name in (
        ("/www/server/panel", "aapanel"),
        ("/usr/local/CyberCP", "cyberpanel"),
        ("/usr/local/cpanel", "cpanel"),
    ):
        if Path(path).exists():
            return name
    return None


def server_info(config=None):
    """Server name: the owner's choice first, hostname when empty.

    A hostname often means nothing to its owner - a fresh VPS is called "vm" or
    "ubuntu-2gb-sgp1". With three servers, the dashboard becomes unreadable.
    """
    os_name = ""
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                os_name = line.partition("=")[2].strip().strip('"')
                break
    except OSError:
        pass

    ip = None
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(1)
        s.connect(("8.8.8.8", 80))  # sends nothing, only picks a route
        ip = s.getsockname()[0]
        s.close()
    except OSError:
        ip = None

    chosen = (config or {}).get("NAMA_SERVER", "").strip()
    return {
        "nama": chosen or socket.gethostname(),
        "os": os_name or platform.system(),
        "kernel": platform.release(),
        "ip_utama": ip,
        "panel_terdeteksi": detect_panel(),
    }


# -------------------------------------------------------------------- reasoner
class Reasoner:
    """The judgement layer. It still answers with no model available.

    Deterministic: the explanation sentences come straight from the catalog -
    they were written for non-technical owners already. Work order follows a
    fixed rule: safe controls first, then risky ones from least to most
    disruptive.

    What a model adds: judging whether an open port is reasonable, turning a
    sudden change into a question an ordinary person can answer, and phrasing
    things around this particular server. With no model, all three fall back to
    fixed answers that stay correct - only stiffer.
    """

    ORDER = ["K03", "K09", "K10", "K08", "K07", "K04", "K06", "K05", "K01", "K02"]

    def __init__(self, config):
        self.config = config
        # Hermes runs its own API server and speaks the OpenAI shape:
        # POST {base}/v1/chat/completions. The provider key lives in Hermes'
        # config, set with `hermes setup` - it is deliberately NOT in
        # yoru.conf, so this file never holds a model credential at all.
        self.base = config.get("HERMES_URL", "").strip().rstrip("/")
        self.model = config.get("AI_MODEL", "").strip() or "hermes"
        self.enabled = bool(self.base)

    def ask(self, instruction, material, limit=400):
        """Ask Hermes for prose. Returns None when anything at all goes wrong.

        Three rules hold this together:
          1. The answer is only ever DISPLAYED. It never becomes a command, a
             control id, or an action. A model that hallucinates here produces
             a wrong sentence, not a wrong change to someone's server.
          2. Everything falls back to the catalog. No model, no network, bad
             JSON - the report still comes out complete, just stiffer.
          3. Short timeout. The daily cycle must not hang because a model is
             slow.
        """
        if not self.enabled:
            return None
        answer = http_json("POST", f"{self.base}/v1/chat/completions", None, {
            "model": self.model,
            "max_tokens": 300,
            "temperature": 0.2,
            "messages": [
                {"role": "system",
                 "content": "Kamu asisten keamanan server yang bicara ke pemilik "
                            "usaha kecil, bukan ke sysadmin. Jawab dalam bahasa "
                            "Indonesia yang sederhana, maksimal 3 kalimat. Jangan "
                            "pernah menuliskan perintah shell, dan jangan menyuruh "
                            "menjalankan apa pun."},
                {"role": "user", "content": f"{instruction}\n\n{material}"},
            ],
        }, timeout=20, label="Hermes")
        try:
            text = answer["choices"][0]["message"]["content"]
        except (TypeError, KeyError, IndexError):
            return None
        text = tidy(text)[:limit]
        return text or None

    def judge_ports(self, raw):
        """Is this open port normal, or is it a hole?

        This is the one judgement a fixed rule does badly. Memorising port
        numbers is the same mistake as pinning SSH to 22 - people move things,
        and there are more services than anyone can list. A model reads the
        process name and says something useful about it.

        Whatever it answers, K05 still refuses to switch the firewall on until
        the owner has actually answered. This adds a sentence to help them
        decide; it does not decide for them.
        """
        return self.ask(
            "Server ini punya port terbuka yang belum dijawab pemiliknya. Untuk "
            "tiap port, jelaskan singkat itu kemungkinan layanan apa, dan apakah "
            "wajar terbuka ke internet atau mencurigakan. Jangan menyuruh "
            "menutup atau membuka apa pun - pemiliknya yang memutuskan.",
            f"Port terbuka: {raw}")

    def order(self, ids):
        rank = {k: i for i, k in enumerate(self.ORDER)}
        return sorted(ids, key=lambda k: rank.get(k, 99))

    def explain(self, kid, catalog, result):
        """The sentence shown to the owner. Sourced from the catalog, not invented."""
        text = tidy(catalog.get(kid, {}).get("kenapa"))
        return text or f"Kontrol {kid} belum punya penjelasan di katalog."

    def consequence(self, kid, catalog):
        text = tidy(catalog.get(kid, {}).get("yang_rusak_kalau_diterapkan"))
        return text or "Belum ada catatan konsekuensi di katalog untuk kontrol ini."

    def drift_question(self, d):
        return (
            f"{d['nama']} berubah pada {d.get('kapan_diubah') or 'waktu yang tidak tercatat'}. "
            f"Sebelumnya {d['berubah_dari']}, sekarang {d['berubah_jadi']}."
            + (f" Yang mengubah: {d['siapa']}." if d.get("siapa") else "")
        )


# ---------------------------------------------------------------- audit trail
def audit_trail(kid, catalog):
    """Who changed it, when, with what command - from auditd (K08).

    May be empty. The contract allows null on purpose: a server whose auditd is
    off genuinely has no trail, and inventing a culprit is far more dangerous
    than admitting we do not know.
    """
    key = {"K01": "ssh_config", "K02": "ssh_config", "K03": "ssh_config",
           "K04": "ssh_config", "K05": "firewall", "K06": "yoru_kontrol",
           "K09": "yoru_kontrol", "K10": "yoru_kontrol"}.get(kid)
    if not key:
        return {}

    text = run_output(["ausearch", "-k", key, "-ts", "recent", "-i"], timeout=20)
    if not text:
        return {}

    block = text.strip().split("----")[-1]
    who = when = command = None
    m = re.search(r"\bauid=(\S+)", block)
    if m and m.group(1) not in {"unset", "-1", "4294967295"}:
        who = m.group(1)
    m = re.search(r"\bAUID=\"([^\"]+)\"", block)
    if m:
        who = m.group(1)
    m = re.search(r"^type=\S+\s+msg=audit\(([^)]*)\)", block, re.M)
    if m:
        when = m.group(1).split(":")[0].strip()
    m = re.search(r"\bcomm=\"?([^\"\s]+)\"?", block)
    if m:
        command = m.group(1)

    return {"siapa": who, "kapan_diubah": when, "perintah": command,
            "sumber_bukti": "auditd"}


# --------------------------------------------------------------------- report
def build_report(cycle, config, catalog, reasoner, checks, previous=None):
    controls = []
    needs_decision = []
    tally = {"LULUS": 0, "GAGAL": 0, "SEBAGIAN": 0, "DILEWATI": 0, "ERROR": 0}

    skip = {x.strip().upper()
            for x in config.get("LEWATI_KONTROL", "").replace(",", " ").split() if x.strip()}

    for kid in ALL_CONTROLS:
        cat = catalog.get(kid, {})
        raw = checks.get(kid, {})
        status = STATUS_MAP.get(raw.get("status", "ERROR"), "ERROR")

        if kid in skip:
            status = "DILEWATI"

        tally[status] = tally.get(status, 0) + 1
        risky = kid not in SAFE

        # Failed preconditions travel with the report so the dashboard does not
        # offer an approve button for a control that cannot run yet.
        blockers = []
        if raw.get("pesan") and raw.get("status") in {"DITOLAK", "ERROR"}:
            blockers.append(tidy(raw["pesan"]))
        if kid == "K05" and raw.get("pesan"):
            blockers = [tidy(raw["pesan"])]

        # Sengaja cuma K05. Itu satu-satunya kontrol yang hasilnya bergantung
        # pada layanan apa yang kebetulan jalan di server ini - selebihnya
        # jawabannya sudah pasti dan sudah ada di katalog.
        note = None
        if kid == "K05" and blockers and reasoner.enabled:
            note = reasoner.judge_ports(blockers[0])

        controls.append({
            "id": kid,
            "nama": cat.get("nama") or kid,
            "kategori": cat.get("kategori") or "lain",
            "kode_cis": str(cat.get("kode_cis") or "-"),
            "risiko": cat.get("risiko") or ("BERISIKO" if risky else "AMAN"),
            "status": status,
            "nilai_terbaca": raw.get("nilai") or "tidak-terbaca",
            "nilai_target": str(cat.get("nilai_target") or ""),
            "kenapa": reasoner.explain(kid, catalog, raw),
            "yang_rusak_kalau_diterapkan": reasoner.consequence(kid, catalog),
            "butuh_izin": risky,
            "prasyarat_gagal": blockers,
            "catatan_ai": note,
            "hasil": None,
        })

        if status == "GAGAL" and risky and kid not in skip and not blockers:
            needs_decision.append(kid)

    total = len(controls)

    report = {
        "versi_kontrak": CONTRACT_VERSION,
        "versi_yoru": (checks.get("K01") or {}).get("versi") or "?",
        "server": server_info(config),
        "waktu": now_iso(),
        "siklus": cycle,
        "ringkasan": {
            "total": total,
            "lulus": tally["LULUS"],
            "gagal": tally["GAGAL"],
            "sebagian": tally["SEBAGIAN"],
            "dilewati": tally["DILEWATI"] + tally["ERROR"],
            "skor": round(tally["LULUS"] / total * 100) if total else 0,
        },
        "kontrol": controls,
        "drift": [],
        "butuh_keputusan": reasoner.order(needs_decision),
    }

    if cycle == "penjagaan" and previous:
        report["drift"] = find_drift(previous, report, catalog)
        for d in report["drift"]:
            if d["id"] not in report["butuh_keputusan"]:
                report["butuh_keputusan"].append(d["id"])

    return report


def find_drift(previous, current, catalog):
    """Controls that used to pass and no longer do.

    This is the heart of the watch cycle. What we look for is not "failing now"
    but "CHANGED" - a server that was never secure to begin with is the fix
    cycle's business, not drift.
    """
    before = {k["id"]: k for k in previous.get("kontrol", [])}
    out = []
    for k in current.get("kontrol", []):
        old = before.get(k["id"])
        if not old or old.get("status") != "LULUS" or k.get("status") == "LULUS":
            continue
        d = {
            "id": k["id"],
            "nama": k["nama"],
            "berubah_dari": old.get("nilai_terbaca"),
            "berubah_jadi": k.get("nilai_terbaca"),
            "terdeteksi": current["waktu"],
            "siapa": None,
            "kapan_diubah": None,
            "perintah": None,
            "sumber_bukti": None,
            "keputusan_pemilik": None,
        }
        d.update({kk: vv for kk, vv in audit_trail(k["id"], catalog).items() if vv})
        out.append(d)
    return out


def save_report(report):
    try:
        HISTORY_DIR.mkdir(parents=True, exist_ok=True)
        stamp = report["waktu"].replace(":", "").replace("+", "p")
        (HISTORY_DIR / f"{stamp}.json").write_text(
            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
        REPORT_FILE.write_text(
            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
        return True
    except OSError as e:
        say(f"laporan tidak bisa disimpan: {e}")
        return False


def read_previous_report():
    try:
        return json.loads(REPORT_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


# ------------------------------------------------------------------ dashboard
def http_json(method, url, token, data=None, timeout=15, label="dashboard"):
    if not url:
        return None
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode("utf-8", "replace")
            return json.loads(body) if body.strip() else {}
    except (urllib.error.URLError, json.JSONDecodeError, OSError) as e:
        say(f"{label} tidak bisa dihubungi ({method} {url}): {e}")
        return None


def send_report(report, config):
    base = config.get("DASHBOARD_URL", "").rstrip("/")
    if not base:
        return
    http_json("POST", f"{base}/api/laporan", config.get("DASHBOARD_TOKEN"), report)


def fetch_decisions(config, server_name):
    """The owner's answers, pulled from the dashboard.

    Traffic goes ONE WAY: the agent contacts the dashboard, never the reverse.
    So the guarded server never has to open a port for the dashboard, and if
    the dashboard is breached the worst an attacker can do is approve a control
    that ALREADY EXISTS in the catalog - they cannot make the server do
    anything new.
    """
    base = config.get("DASHBOARD_URL", "").rstrip("/")
    if not base:
        return {}
    # The server name is mandatory. One dashboard can hold many servers, and
    # without this filter the agent on server A would carry out answers meant
    # for server B - including "turn off password login" on a machine whose
    # owner was never asked.
    j = http_json("GET",
                  f"{base}/api/keputusan?server={urllib.parse.quote(server_name)}",
                  config.get("DASHBOARD_TOKEN"))
    if not isinstance(j, dict):
        return {}
    out = {}
    for kid, val in (j.get("keputusan") or {}).items():
        if kid in ALL_CONTROLS and val in {"setuju", "tolak", "sah", "kembalikan"}:
            out[kid] = val
    return {"kontrol": out, "port": j.get("port_disetujui") or []}


def record_ports(ports):
    """Ports the owner vouched for: "yes, that one is mine"."""
    valid = [str(int(p)) for p in ports if str(p).isdigit() and 1 <= int(p) <= 65535]
    if not valid:
        return
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        existing = set()
        if PORT_FILE.exists():
            for line in PORT_FILE.read_text().splitlines():
                line = line.split("#")[0].strip()
                if line.isdigit():
                    existing.add(line)
        PORT_FILE.write_text(
            "# dijawab pemilik lewat dashboard\n" +
            "\n".join(sorted(existing | set(valid), key=int)) + "\n", encoding="utf-8")
    except OSError as e:
        say(f"port-disetujui tidak bisa ditulis: {e}")


# ------------------------------------------------------------------- telegram
def notify_telegram(report, config):
    """Tell the owner - but only when there is something to tell.

    What is never sent: a daily "everything is still fine". A notification that
    arrives every day carrying nothing gets muted within a week, and the one
    that mattered gets muted with it. So Yoru only speaks up when something
    changed or something needs an answer.
    """
    token = config.get("TELEGRAM_TOKEN", "").strip()
    chat = config.get("TELEGRAM_CHAT_ID", "").strip()
    if not token or not chat:
        return False

    summary = report["ringkasan"]
    drift = report.get("drift") or []
    asking = report.get("butuh_keputusan") or []
    if not drift and not asking:
        say("tidak ada yang perlu dikabarkan - Telegram dilewati")
        return False

    name = (report.get("server") or {}).get("nama") or "server kamu"
    lines = [f"*{name}* - skor {summary['skor']}/100 "
             f"({summary['lulus']} dari {summary['total']} aman)"]

    if drift:
        lines.append("")
        lines.append("*Ada yang berubah:*")
        for d in drift[:5]:
            who = f" oleh {d['siapa']}" if d.get("siapa") else ""
            lines.append(f"- {d['nama']}: {d['berubah_dari']} jadi {d['berubah_jadi']}{who}")

    if asking:
        lines.append("")
        lines.append(f"*{len(asking)} hal nunggu jawaban kamu:*")
        by_id = {k["id"]: k for k in report["kontrol"]}
        for kid in asking[:5]:
            k = by_id.get(kid)
            if k:
                lines.append(f"- {k['nama']}")

    base = config.get("DASHBOARD_URL", "").rstrip("/")
    if base:
        lines.append("")
        lines.append(f"Buka {base} buat jawab.")

    # The text is NOT assembled from raw command output - all of it comes from
    # the catalog and from values yoructl already validated. A filename or
    # username containing Markdown characters can at worst look ugly; it cannot
    # smuggle another message out.
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    data = {"chat_id": chat, "text": "\n".join(lines), "parse_mode": "Markdown"}
    if http_json("POST", url, None, data) is None:
        say("Telegram tidak bisa dihubungi - laporan tetap tersimpan")
        return False
    say("kabar terkirim ke Telegram")
    return True


# ------------------------------------------------------------------- applying
def apply_one(kid):
    """Apply, then verify. berhasil=true ONLY when verification passed.

    This is rule one in contract/report.md, and it is not a formality: we have
    had a control write its file, pass `sshd -t`, and reload without error
    while the server's setting did not change at all. "The command ran" is not
    evidence; only reading the state back is.
    """
    started = time.time()
    applied = call_yoructl(kid, "terapkan")
    elapsed = round(time.time() - started, 1)

    if applied.get("status") == "DILEWATI":
        return {"tindakan": "lewati", "berhasil": True,
                "nilai_sesudah": applied.get("nilai"), "diverifikasi": True,
                "snapshot_id": None, "dirollback": False,
                "pesan_error": None, "durasi_detik": elapsed}

    if not applied.get("berhasil"):
        return {"tindakan": "terapkan", "berhasil": False,
                "nilai_sesudah": applied.get("nilai"), "diverifikasi": False,
                "snapshot_id": None, "dirollback": False,
                "pesan_error": applied.get("pesan") or applied.get("status"),
                "durasi_detik": elapsed}

    verified = call_yoructl(kid, "verifikasi")
    ok = verified.get("status") == "LULUS"
    return {
        "tindakan": "terapkan",
        "berhasil": bool(ok),
        "nilai_sesudah": verified.get("nilai"),
        "diverifikasi": ok,
        "snapshot_id": f"yoru-{kid}-{datetime.now().strftime('%Y%m%dT%H%M%S')}",
        "dirollback": False,
        "pesan_error": None if ok else "verifikasi tidak LULUS",
        "durasi_detik": round(time.time() - started, 1),
    }


def execute(report, decisions, dry_run=False):
    """Safe controls run on their own. Risky ones only with the owner's yes."""
    by_id = {k["id"]: k for k in report["kontrol"]}
    done = []

    for kid in ALL_CONTROLS:
        k = by_id.get(kid)
        if not k or k["status"] != "GAGAL" or k["prasyarat_gagal"]:
            continue

        if kid in SAFE:
            reason = "aman - tidak perlu bertanya"
        elif decisions.get(kid) == "setuju":
            reason = "disetujui pemilik"
        else:
            continue

        if dry_run:
            say(f"(kering) {kid} akan diterapkan - {reason}")
            continue

        say(f"{kid} terapkan - {reason}")
        k["hasil"] = apply_one(kid)
        done.append(kid)

    for kid in list(decisions):
        if decisions[kid] == "kembalikan" and not dry_run:
            say(f"{kid} kembalikan - diminta pemilik")
            r = call_yoructl(kid, "kembalikan")
            if by_id.get(kid):
                by_id[kid]["hasil"] = {
                    "tindakan": "kembalikan", "berhasil": bool(r.get("berhasil")),
                    "nilai_sesudah": r.get("nilai"), "diverifikasi": bool(r.get("berhasil")),
                    "snapshot_id": None, "dirollback": True,
                    "pesan_error": r.get("pesan"), "durasi_detik": None,
                }
            done.append(kid)

    return done


def refresh(report, catalog, reasoner, done):
    """Re-read the controls we just touched, then recount the score."""
    if not done:
        return report
    by_id = {k["id"]: k for k in report["kontrol"]}
    for kid in done:
        m = call_yoructl(kid, "periksa")
        if kid in by_id:
            by_id[kid]["status"] = STATUS_MAP.get(m.get("status", "ERROR"), "ERROR")
            by_id[kid]["nilai_terbaca"] = m.get("nilai") or "tidak-terbaca"

    tally = {"LULUS": 0, "GAGAL": 0, "SEBAGIAN": 0, "DILEWATI": 0, "ERROR": 0}
    for k in report["kontrol"]:
        tally[k["status"]] = tally.get(k["status"], 0) + 1
    total = len(report["kontrol"])
    report["ringkasan"] = {
        "total": total, "lulus": tally["LULUS"], "gagal": tally["GAGAL"],
        "sebagian": tally["SEBAGIAN"], "dilewati": tally["DILEWATI"] + tally["ERROR"],
        "skor": round(tally["LULUS"] / total * 100) if total else 0,
    }
    report["butuh_keputusan"] = reasoner.order(
        [k["id"] for k in report["kontrol"]
         if k["status"] == "GAGAL" and k["butuh_izin"] and not k["prasyarat_gagal"]]
    )
    report["waktu"] = now_iso()
    return report


# ----------------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(description="Yoru agent")
    ap.add_argument("--siklus", choices=["perbaikan", "penjagaan"], default="penjagaan")
    ap.add_argument("--konfigurasi", default="/etc/yoru/yoru.conf")
    ap.add_argument("--kering", action="store_true",
                    help="cuma periksa dan susun laporan, jangan ubah apa pun")
    ap.add_argument("--tanpa-kirim", action="store_true",
                    help="jangan hubungi dashboard")
    ap.add_argument("--keluar", default=None,
                    help="tulis laporan ke berkas ini juga (untuk pengujian)")
    args = ap.parse_args()

    # Same rule as yoru-watch. Run as root, the agent no longer goes through
    # sudoers, so every restriction on it becomes decorative. And there is a
    # quiet side effect: the report it writes ends up owned by root, and the
    # next daily cycle can never overwrite it again - failing silently.
    if os.geteuid() == 0:
        say("berhenti: harus berjalan sebagai yoru-agent, bukan root")
        say("coba: sudo -u yoru-agent /opt/yoru/bin/yoru-agent "
            f"--siklus {args.siklus}")
        return 2

    config = read_config(args.konfigurasi)
    catalog = read_catalog()
    if not catalog:
        say("katalog kosong - tidak bisa menyusun laporan")
        return 3
    reasoner = Reasoner(config)

    say(f"siklus {args.siklus}, memeriksa {len(ALL_CONTROLS)} kontrol")
    checks = {kid: call_yoructl(kid, "periksa") for kid in ALL_CONTROLS}

    report = build_report(args.siklus, config, catalog, reasoner, checks,
                          read_previous_report() if args.siklus == "penjagaan" else None)
    say(f"skor {report['ringkasan']['skor']} "
        f"(lulus {report['ringkasan']['lulus']}/{report['ringkasan']['total']}), "
        f"drift {len(report['drift'])}, "
        f"menunggu keputusan {len(report['butuh_keputusan'])}")

    decisions = {}
    if not args.tanpa_kirim:
        send_report(report, config)
        answer = fetch_decisions(config, report["server"]["nama"])
        decisions = answer.get("kontrol", {}) if isinstance(answer, dict) else {}
        record_ports(answer.get("port", []) if isinstance(answer, dict) else [])

    done = execute(report, decisions, dry_run=args.kering)
    if done:
        report = refresh(report, catalog, reasoner, done)
        say(f"skor sesudah dikerjakan: {report['ringkasan']['skor']}")

    save_report(report)
    if not args.tanpa_kirim:
        if done:
            send_report(report, config)
        notify_telegram(report, config)
    if args.keluar:
        Path(args.keluar).write_text(
            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")

    print(json.dumps(report["ringkasan"], ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
