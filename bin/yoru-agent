#!/usr/bin/env python3
"""
yoru-agent - the brain. Called daily by yoru-watch:
    yoru-agent --siklus penjagaan --konfigurasi /etc/yoru/yoru.conf

Checks the ten controls through yoructl, builds the contract/report.md report,
sends it to the dashboard, collects the owner's answers, applies what it is
allowed to apply. Two invariants:
  - The agent NEVER assembles a shell command: it calls yoructl with a control
    number and an action name, never a string built from config, owner answers
    or model output. No subprocess(shell=True) here.
  - The report must assemble with NO model at all. Owner-facing sentences come
    from the catalog; a model only adds a layer on top.
"""

import argparse
import json
import os
import platform
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

CONTRACT_VERSION = "1"

TELEGRAM_API = "https://api.telegram.org"

YORUCTL = "/opt/yoru/bin/yoructl"
CATALOG_DIR = Path("/usr/share/yoru/catalog")
DATA_DIR = Path("/var/lib/yoru")
HISTORY_DIR = DATA_DIR / "history"
REPORT_FILE = DATA_DIR / "laporan-terakhir.json"
PORT_FILE = DATA_DIR / "port-disetujui"

ALL_CONTROLS = [f"K{n:02d}" for n in range(1, 11)]

# Must match the catalog, or a risky control could run without approval.
SAFE = {"K03", "K07", "K08", "K09", "K10"}

# yoructl -> contract. DITOLAK on a check is a bad request, not a failed control.
STATUS_MAP = {
    "LULUS": "LULUS",
    "GAGAL": "GAGAL",
    "DILEWATI": "DILEWATI",
    "DIKEMBALIKAN": "DILEWATI",
    "DITOLAK": "ERROR",
    "ERROR": "ERROR",
    "PERINGATAN": "ERROR",
}


# Zone for every timestamp in the report; None means this machine's own.
REPORT_TZ = None


def use_timezone(name):
    """Honour ZONA_WAKTU; a bad name falls back to the machine's zone and says so."""
    global REPORT_TZ
    name = (name or "").strip()
    if not name:
        return
    try:
        from zoneinfo import ZoneInfo, available_timezones
    except ImportError:
        say("python di server ini tidak punya zoneinfo - memakai zona waktu server")
        return
    try:
        REPORT_TZ = ZoneInfo(name)
        return
    except Exception:  # noqa: BLE001 - the reason is worked out below, not guessed
        pass

    # Two different failures raise the same exception; an empty list means no tzdata.
    REPORT_TZ = None
    try:
        has_db = bool(available_timezones())
    except Exception:  # noqa: BLE001
        has_db = False
    if has_db:
        say(f"ZONA_WAKTU '{name}' tidak dikenal - periksa ejaannya, "
            f"contoh: Asia/Jakarta. Sementara memakai zona waktu server")
    else:
        say(f"server ini belum punya database zona waktu, jadi '{name}' tidak bisa "
            f"dipakai - pasang dengan: apt-get install -y tzdata. "
            f"Sementara memakai zona waktu server")


def now_iso():
    return datetime.now(timezone.utc).astimezone(REPORT_TZ).isoformat(timespec="seconds")


def say(*a):
    print("[yoru-agent]", *a, file=sys.stderr, flush=True)


# --------------------------------------------------------------------- config
def read_config(path):
    """Read as TEXT, never sourced: `source` or `exec` would turn the config
    file into a place to put commands that run as root, uninspected."""
    config = {}
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return config
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
        config[key.strip()] = val
    return config


def read_catalog():
    """The facts for each control; the agent invents nothing beyond it."""
    try:
        import yaml
    except ImportError:
        say("PyYAML tidak ada - pasang dengan: apt-get install -y python3-yaml")
        return {}

    catalog = {}
    for kid in ALL_CONTROLS:
        path = CATALOG_DIR / f"{kid}.yaml"
        try:
            catalog[kid] = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        except Exception as e:  # noqa: BLE001
            say(f"katalog {kid} tidak terbaca: {e}")
            catalog[kid] = {}
    return catalog


def tidy(text):
    """YAML folded blocks leave stray newlines and double spaces behind."""
    if not text:
        return ""
    return re.sub(r"\s+", " ", str(text)).strip()


# ------------------------------------------------------------------ execution
def call_yoructl(kid, action, timeout=180):
    """One program, two arguments. No shell, no assembled strings."""
    if kid not in ALL_CONTROLS or action not in {
        "periksa", "terapkan", "kembalikan", "verifikasi"
    }:
        return {"status": "ERROR", "ok": False,
                "message": "kontrol atau tindakan tidak dikenal", "value": None}

    cmd = ["sudo", "-n", YORUCTL, kid, action]
    if os.geteuid() == 0:
        cmd = [YORUCTL, kid, action]

    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"status": "ERROR", "ok": False, "value": None,
                "message": f"yoructl {kid} {action} lewat batas {timeout} detik"}
    except OSError as e:
        return {"status": "ERROR", "ok": False, "value": None,
                "message": f"tidak bisa memanggil yoructl: {e}"}

    # yoructl always prints one JSON line as the last line of stdout.
    for line in reversed([b for b in p.stdout.splitlines() if b.strip()]):
        try:
            return json.loads(line)
        except json.JSONDecodeError:
            continue

    return {"status": "ERROR", "ok": False, "value": None,
            "message": (p.stderr or "yoructl tidak mengeluarkan JSON").strip()[:300]}


def run_output(cmd, timeout=10):
    """Argument list, never a shell string."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


# ---------------------------------------------------------------- server info
def detect_panel():
    for path, name in (
        ("/www/server/panel", "aapanel"),
        ("/usr/local/CyberCP", "cyberpanel"),
        ("/usr/local/cpanel", "cpanel"),
    ):
        if Path(path).exists():
            return name
    return None


def server_info(config=None):
    """Server name: NAMA_SERVER first, hostname when empty."""
    os_name = ""
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("PRETTY_NAME="):
                os_name = line.partition("=")[2].strip().strip('"')
                break
    except OSError:
        pass

    ip = None
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(1)
        s.connect(("8.8.8.8", 80))  # sends nothing, only picks a route
        ip = s.getsockname()[0]
        s.close()
    except OSError:
        ip = None

    chosen = (config or {}).get("NAMA_SERVER", "").strip()
    return {
        "name": chosen or socket.gethostname(),
        "os": os_name or platform.system(),
        "kernel": platform.release(),
        "primary_ip": ip,
        "detected_panel": detect_panel(),
    }


# -------------------------------------------------------------------- reasoner
class Reasoner:
    """Judgement layer; still answers with no model. Explanations come from the
    catalog. Fixed work order: safe controls first, risky ones least-disruptive first."""

    ORDER = ["K03", "K09", "K10", "K08", "K07", "K04", "K06", "K05", "K01", "K02"]

    def __init__(self, config):
        self.config = config
        # OpenAI-shaped API at POST {base}/v1/chat/completions. HERMES_TOKEN is a
        # local-service token; the provider API key stays in Hermes' own config,
        # deliberately not in yoru.conf.
        self.base = config.get("HERMES_URL", "").strip().rstrip("/")
        self.model = config.get("AI_MODEL", "").strip() or "hermes"
        self.token = config.get("HERMES_TOKEN", "").strip()
        self.enabled = bool(self.base)

    def ask(self, instruction, material, limit=400):
        """Ask Hermes for prose; None on any failure. The answer is only ever
        DISPLAYED - never a command, control id or action; no model, no network
        or bad JSON falls back to the catalog; short timeout so the daily cycle
        cannot hang on a slow model."""
        if not self.enabled:
            return None
        answer = http_json("POST", f"{self.base}/v1/chat/completions", self.token, {
            "model": self.model,
            "max_tokens": 300,
            "temperature": 0.2,
            "messages": [
                {"role": "system",
                 "content": "Kamu asisten keamanan server yang bicara ke pemilik "
                            "usaha kecil, bukan ke sysadmin. Jawab dalam bahasa "
                            "Indonesia yang sederhana, maksimal 3 kalimat. Jangan "
                            "pernah menuliskan perintah shell, dan jangan menyuruh "
                            "menjalankan apa pun."},
                {"role": "user", "content": f"{instruction}\n\n{material}"},
            ],
        }, timeout=20, label="Hermes")
        try:
            text = answer["choices"][0]["message"]["content"]
        except (TypeError, KeyError, IndexError):
            return None
        text = tidy(text)[:limit]
        return text or None

    def judge_ports(self, raw):
        """A displayed sentence about open ports; K05 still waits for the owner."""
        return self.ask(
            "Server ini punya port terbuka yang belum dijawab pemiliknya. Untuk "
            "tiap port, jelaskan singkat itu kemungkinan layanan apa, dan apakah "
            "wajar terbuka ke internet atau mencurigakan. Jangan menyuruh "
            "menutup atau membuka apa pun - pemiliknya yang memutuskan.",
            f"Port terbuka: {raw}")

    def order(self, ids):
        rank = {k: i for i, k in enumerate(self.ORDER)}
        return sorted(ids, key=lambda k: rank.get(k, 99))

    def explain(self, kid, catalog, result):
        text = tidy(catalog.get(kid, {}).get("why"))
        return text or f"Kontrol {kid} belum punya penjelasan di katalog."

    def consequence(self, kid, catalog):
        text = tidy(catalog.get(kid, {}).get("breaks_if_applied"))
        return text or "Belum ada catatan konsekuensi di katalog untuk kontrol ini."

    def drift_question(self, d):
        return (
            f"{d['name']} berubah pada {d.get('changed_at') or 'waktu yang tidak tercatat'}. "
            f"Sebelumnya {d['changed_from']}, sekarang {d['changed_to']}."
            + (f" Yang mengubah: {d['who']}." if d.get("who") else "")
        )


# ---------------------------------------------------------------- audit trail
def audit_trail(kid, catalog):
    """Who changed it, when, with what - from auditd (K08). Often empty: with
    auditd off there is no trail, and inventing a culprit is worse than null."""
    key = {"K01": "ssh_config", "K02": "ssh_config", "K03": "ssh_config",
           "K04": "ssh_config", "K05": "firewall", "K06": "yoru_kontrol",
           "K09": "yoru_kontrol", "K10": "yoru_kontrol"}.get(kid)
    if not key:
        return {}

    text = run_output(["ausearch", "-k", key, "-ts", "recent", "-i"], timeout=20)
    if not text:
        return {}

    block = text.strip().split("----")[-1]
    who = when = command = None
    m = re.search(r"\bauid=(\S+)", block)
    if m and m.group(1) not in {"unset", "-1", "4294967295"}:
        who = m.group(1)
    m = re.search(r"\bAUID=\"([^\"]+)\"", block)
    if m:
        who = m.group(1)
    m = re.search(r"^type=\S+\s+msg=audit\(([^)]*)\)", block, re.M)
    if m:
        when = m.group(1).split(":")[0].strip()
    m = re.search(r"\bcomm=\"?([^\"\s]+)\"?", block)
    if m:
        command = m.group(1)

    return {"who": who, "changed_at": when, "command": command,
            "evidence_source": "auditd"}


# --------------------------------------------------------------------- report
def build_report(cycle, config, catalog, reasoner, checks, previous=None):
    controls = []
    needs_decision = []
    tally = {"LULUS": 0, "GAGAL": 0, "SEBAGIAN": 0, "DILEWATI": 0, "ERROR": 0}

    skip = {x.strip().upper()
            for x in config.get("LEWATI_KONTROL", "").replace(",", " ").split() if x.strip()}

    for kid in ALL_CONTROLS:
        cat = catalog.get(kid, {})
        raw = checks.get(kid, {})
        status = STATUS_MAP.get(raw.get("status", "ERROR"), "ERROR")

        if kid in skip:
            status = "DILEWATI"

        tally[status] = tally.get(status, 0) + 1
        risky = kid not in SAFE

        # Failed preconditions travel with the report so the dashboard offers no
        # approve button for a control that cannot run yet.
        blockers = []
        if raw.get("message") and raw.get("status") in {"DITOLAK", "ERROR"}:
            blockers.append(tidy(raw["message"]))
        if kid == "K05" and raw.get("message"):
            blockers = [tidy(raw["message"])]

        # Sengaja cuma K05: hasilnya bergantung pada layanan yang kebetulan jalan
        # di server ini, sisanya jawabannya sudah pasti dan ada di katalog.
        note = None
        if kid == "K05" and blockers and reasoner.enabled:
            note = reasoner.judge_ports(blockers[0])

        controls.append({
            "id": kid,
            "name": cat.get("name") or kid,
            "category": cat.get("category") or "lain",
            "cis_code": str(cat.get("cis_code") or "-"),
            "risk": cat.get("risk") or ("BERISIKO" if risky else "AMAN"),
            "status": status,
            "observed": raw.get("value") or "tidak-terbaca",
            "target": str(cat.get("target") or ""),
            "why": reasoner.explain(kid, catalog, raw),
            "breaks_if_applied": reasoner.consequence(kid, catalog),
            "needs_approval": risky,
            "blockers": blockers,
            "ai_note": note,
            "result": None,
        })

        if status == "GAGAL" and risky and kid not in skip and not blockers:
            needs_decision.append(kid)

    total = len(controls)

    report = {
        "contract_version": CONTRACT_VERSION,
        "yoru_version": (checks.get("K01") or {}).get("version") or "?",
        "server": server_info(config),
        "time": now_iso(),
        "cycle": cycle,
        "summary": {
            "total": total,
            "passed": tally["LULUS"],
            "failed": tally["GAGAL"],
            "partial": tally["SEBAGIAN"],
            "skipped": tally["DILEWATI"] + tally["ERROR"],
            "score": round(tally["LULUS"] / total * 100) if total else 0,
        },
        "controls": controls,
        "drift": [],
        "pending_decisions": reasoner.order(needs_decision),
    }

    if cycle == "penjagaan" and previous:
        report["drift"] = find_drift(previous, report, catalog)
        for d in report["drift"]:
            if d["id"] not in report["pending_decisions"]:
                report["pending_decisions"].append(d["id"])

    return report


def find_drift(previous, current, catalog):
    """Controls that used to pass and no longer do. The test is CHANGED, not
    "failing now": a server that was never secure is the fix cycle's business."""
    before = {k["id"]: k for k in previous.get("controls", [])}
    out = []
    for k in current.get("controls", []):
        old = before.get(k["id"])
        if not old or old.get("status") != "LULUS" or k.get("status") == "LULUS":
            continue
        d = {
            "id": k["id"],
            "name": k["name"],
            "changed_from": old.get("observed"),
            "changed_to": k.get("observed"),
            "detected": current["time"],
            "who": None,
            "changed_at": None,
            "command": None,
            "evidence_source": None,
            "owner_decision": None,
        }
        d.update({kk: vv for kk, vv in audit_trail(k["id"], catalog).items() if vv})
        out.append(d)
    return out


def save_report(report):
    try:
        HISTORY_DIR.mkdir(parents=True, exist_ok=True)
        stamp = report["time"].replace(":", "").replace("+", "p")
        (HISTORY_DIR / f"{stamp}.json").write_text(
            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
        REPORT_FILE.write_text(
            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
        return True
    except OSError as e:
        say(f"laporan tidak bisa disimpan: {e}")
        return False


def read_previous_report():
    try:
        return json.loads(REPORT_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


# ------------------------------------------------------------------ dashboard
def http_json(method, url, token, data=None, timeout=15, label="dashboard"):
    if not url:
        return None
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode("utf-8", "replace")
            return json.loads(body) if body.strip() else {}
    except (urllib.error.URLError, json.JSONDecodeError, OSError) as e:
        say(f"{label} tidak bisa dihubungi ({method} {url}): {e}")
        return None


def send_report(report, config):
    base = config.get("DASHBOARD_URL", "").rstrip("/")
    if not base:
        return
    http_json("POST", f"{base}/api/report", config.get("DASHBOARD_TOKEN"), report)


def fetch_decisions(config, server_name):
    """The owner's answers. Traffic goes ONE WAY - the agent contacts the
    dashboard, never the reverse - so the guarded server opens no port for it."""
    base = config.get("DASHBOARD_URL", "").rstrip("/")
    if not base:
        return {}
    # The server name is mandatory: one dashboard holds many servers, and without
    # the filter this agent would carry out answers meant for another one.
    j = http_json("GET",
                  f"{base}/api/decision?server={urllib.parse.quote(server_name)}",
                  config.get("DASHBOARD_TOKEN"))
    if not isinstance(j, dict):
        return {}
    out = {}
    for kid, val in (j.get("decisions") or {}).items():
        if kid in ALL_CONTROLS and val in {"setuju", "tolak", "sah", "kembalikan"}:
            out[kid] = val
    return {"decisions": out, "port": j.get("approved_ports") or []}


def record_ports(ports):
    valid = [str(int(p)) for p in ports if str(p).isdigit() and 1 <= int(p) <= 65535]
    if not valid:
        return
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        existing = set()
        if PORT_FILE.exists():
            for line in PORT_FILE.read_text().splitlines():
                line = line.split("#")[0].strip()
                if line.isdigit():
                    existing.add(line)
        PORT_FILE.write_text(
            "# dijawab pemilik lewat dashboard\n" +
            "\n".join(sorted(existing | set(valid), key=int)) + "\n", encoding="utf-8")
    except OSError as e:
        say(f"port-disetujui tidak bisa ditulis: {e}")


# ------------------------------------------------------------------- telegram
def find_chat_id(token):
    """A bot cannot start a conversation: the owner sends /start, the next cycle
    picks the id up from getUpdates. Hence TELEGRAM_CHAT_ID may be left empty."""
    answer = http_json("GET", f"{TELEGRAM_API}/bot{token}/getUpdates?limit=10",
                       None, timeout=15, label="Telegram")
    if not isinstance(answer, dict) or not answer.get("ok"):
        return ""
    for update in reversed(answer.get("result") or []):
        for key in ("message", "edited_message", "channel_post"):
            chat = ((update.get(key) or {}).get("chat") or {}).get("id")
            if chat is not None:
                return str(chat)
    return ""


def remember_chat_id(chat):
    """Goes through yoructl, which validates the value: the agent itself cannot
    write /etc/yoru/yoru.conf."""
    cmd = ["sudo", "-n", YORUCTL, "konfigurasi", "TELEGRAM_CHAT_ID", chat]
    if os.geteuid() == 0:
        cmd = [YORUCTL, "konfigurasi", "TELEGRAM_CHAT_ID", chat]
    try:
        subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        say(f"chat id Telegram ketemu ({chat}) dan disimpan")
    except (OSError, subprocess.TimeoutExpired) as e:
        say(f"chat id ketemu tapi gagal disimpan: {e}")


def notify_telegram(report, config):
    """Sends only when something changed or needs an answer, never a daily all-clear."""
    token = config.get("TELEGRAM_TOKEN", "").strip()
    if not token:
        return False

    chat = config.get("TELEGRAM_CHAT_ID", "").strip()
    if not chat:
        chat = find_chat_id(token)
        if not chat:
            say("chat id Telegram belum ketemu - kirim /start ke botmu, "
                "lalu jalankan siklus ini lagi")
            return False
        remember_chat_id(chat)

    summary = report["summary"]
    drift = report.get("drift") or []
    asking = report.get("pending_decisions") or []
    if not drift and not asking:
        say("tidak ada yang perlu dikabarkan - Telegram dilewati")
        return False

    name = (report.get("server") or {}).get("name") or "server kamu"
    lines = [f"*{name}* - skor {summary['score']}/100 "
             f"({summary['passed']} dari {summary['total']} aman)"]

    if drift:
        lines.append("")
        lines.append("*Ada yang berubah:*")
        for d in drift[:5]:
            who = f" oleh {d['who']}" if d.get("who") else ""
            lines.append(f"- {d['name']}: {d['changed_from']} jadi {d['changed_to']}{who}")

    if asking:
        lines.append("")
        lines.append(f"*{len(asking)} hal nunggu jawaban kamu:*")
        by_id = {k["id"]: k for k in report["controls"]}
        for kid in asking[:5]:
            k = by_id.get(kid)
            if k:
                lines.append(f"- {k['name']}")

    base = config.get("DASHBOARD_URL", "").rstrip("/")
    if base:
        lines.append("")
        lines.append(f"Buka {base} buat jawab.")

    # The text comes from the catalog and from values yoructl already validated,
    # so stray Markdown can look ugly but cannot smuggle another message out.
    url = f"{TELEGRAM_API}/bot{token}/sendMessage"
    data = {"chat_id": chat, "text": "\n".join(lines), "parse_mode": "Markdown"}
    if http_json("POST", url, None, data) is None:
        say("Telegram tidak bisa dihubungi - laporan tetap tersimpan")
        return False
    say("kabar terkirim ke Telegram")
    return True


def test_telegram(config):
    """One test message, so a wrong token surfaces before real drift does."""
    token = config.get("TELEGRAM_TOKEN", "").strip()
    if not token:
        say("TELEGRAM_TOKEN kosong - isi dulu di dashboard, menu Telegram Bot")
        return False

    chat = config.get("TELEGRAM_CHAT_ID", "").strip()
    if not chat:
        chat = find_chat_id(token)
        if not chat:
            say("Belum ada yang pernah mengirim pesan ke bot ini.")
            say("Buka botmu di Telegram, tekan Start, lalu ulangi perintah ini.")
            return False
        remember_chat_id(chat)

    name = (config.get("NAMA_SERVER") or socket.gethostname()).strip()
    sent = http_json("POST", f"{TELEGRAM_API}/bot{token}/sendMessage", None,
                     {"chat_id": chat,
                      "text": f"Yoru terhubung. Server: *{name}*\n"
                              f"Ini pesan uji - kabar berikutnya cuma dikirim "
                              f"kalau ada yang berubah atau ada yang perlu dijawab.",
                      "parse_mode": "Markdown"},
                     timeout=15, label="Telegram")
    if not isinstance(sent, dict) or not sent.get("ok"):
        say("Telegram menolak pesannya. Biasanya tokennya salah ketik.")
        if isinstance(sent, dict) and sent.get("description"):
            say(f"Kata Telegram: {sent['description']}")
        return False
    say(f"Terkirim ke chat {chat}. Cek Telegram-mu.")
    return True


# ------------------------------------------------------------------- applying
def apply_one(kid):
    """Apply, then verify; berhasil=true ONLY when verification passed. We have
    had a control write its file, pass `sshd -t` and reload cleanly while the
    setting did not change - only reading the state back is evidence."""
    started = time.time()
    applied = call_yoructl(kid, "terapkan")
    elapsed = round(time.time() - started, 1)

    if applied.get("status") == "DILEWATI":
        return {"action": "lewati", "ok": True,
                "nilai_sesudah": applied.get("value"), "diverifikasi": True,
                "snapshot_id": None, "dirollback": False,
                "pesan_error": None, "durasi_detik": elapsed}

    if not applied.get("ok"):
        return {"action": "terapkan", "ok": False,
                "nilai_sesudah": applied.get("value"), "diverifikasi": False,
                "snapshot_id": None, "dirollback": False,
                "pesan_error": applied.get("message") or applied.get("status"),
                "durasi_detik": elapsed}

    verified = call_yoructl(kid, "verifikasi")
    ok = verified.get("status") == "LULUS"
    return {
        "action": "terapkan",
        "ok": bool(ok),
        "nilai_sesudah": verified.get("value"),
        "diverifikasi": ok,
        "snapshot_id": f"yoru-{kid}-{datetime.now().strftime('%Y%m%dT%H%M%S')}",
        "dirollback": False,
        "pesan_error": None if ok else "verifikasi tidak LULUS",
        "durasi_detik": round(time.time() - started, 1),
    }


def execute(report, decisions, dry_run=False):
    """Safe controls run on their own. Risky ones only with the owner's yes."""
    by_id = {k["id"]: k for k in report["controls"]}
    done = []

    for kid in ALL_CONTROLS:
        k = by_id.get(kid)
        if not k or k["status"] != "GAGAL" or k["blockers"]:
            continue

        if kid in SAFE:
            reason = "aman - tidak perlu bertanya"
        elif decisions.get(kid) == "setuju":
            reason = "disetujui pemilik"
        else:
            continue

        if dry_run:
            say(f"(kering) {kid} akan diterapkan - {reason}")
            continue

        say(f"{kid} terapkan - {reason}")
        k["result"] = apply_one(kid)
        done.append(kid)

    for kid in list(decisions):
        if decisions[kid] == "kembalikan" and not dry_run:
            say(f"{kid} kembalikan - diminta pemilik")
            r = call_yoructl(kid, "kembalikan")
            if by_id.get(kid):
                by_id[kid]["result"] = {
                    "action": "kembalikan", "ok": bool(r.get("ok")),
                    "nilai_sesudah": r.get("value"), "diverifikasi": bool(r.get("ok")),
                    "snapshot_id": None, "dirollback": True,
                    "pesan_error": r.get("message"), "durasi_detik": None,
                }
            done.append(kid)

    return done


def refresh(report, catalog, reasoner, done):
    if not done:
        return report
    by_id = {k["id"]: k for k in report["controls"]}
    for kid in done:
        m = call_yoructl(kid, "periksa")
        if kid in by_id:
            by_id[kid]["status"] = STATUS_MAP.get(m.get("status", "ERROR"), "ERROR")
            by_id[kid]["observed"] = m.get("value") or "tidak-terbaca"

    tally = {"LULUS": 0, "GAGAL": 0, "SEBAGIAN": 0, "DILEWATI": 0, "ERROR": 0}
    for k in report["controls"]:
        tally[k["status"]] = tally.get(k["status"], 0) + 1
    total = len(report["controls"])
    report["summary"] = {
        "total": total, "passed": tally["LULUS"], "failed": tally["GAGAL"],
        "partial": tally["SEBAGIAN"], "skipped": tally["DILEWATI"] + tally["ERROR"],
        "score": round(tally["LULUS"] / total * 100) if total else 0,
    }
    report["pending_decisions"] = reasoner.order(
        [k["id"] for k in report["controls"]
         if k["status"] == "GAGAL" and k["needs_approval"] and not k["blockers"]]
    )
    report["time"] = now_iso()
    return report


# ----------------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(description="Yoru agent")
    ap.add_argument("--siklus", choices=["perbaikan", "penjagaan"], default="penjagaan")
    ap.add_argument("--konfigurasi", default="/etc/yoru/yoru.conf")
    ap.add_argument("--kering", action="store_true",
                    help="cuma periksa dan susun laporan, jangan ubah apa pun")
    ap.add_argument("--tanpa-kirim", action="store_true",
                    help="jangan hubungi dashboard")
    ap.add_argument("--keluar", default=None,
                    help="tulis laporan ke berkas ini juga (untuk pengujian)")
    ap.add_argument("--tes-telegram", action="store_true",
                    help="kirim satu pesan uji ke Telegram lalu berhenti")
    args = ap.parse_args()

    # Same rule as yoru-watch. As root the agent bypasses sudoers, making every
    # restriction on it decorative, and leaves the report owned by root - which
    # the next daily cycle then fails to overwrite, silently.
    if os.geteuid() == 0:
        say("berhenti: harus berjalan sebagai yoru-agent, bukan root")
        say("coba: sudo -u yoru-agent /opt/yoru/bin/yoru-agent "
            f"--siklus {args.siklus}")
        return 2

    config = read_config(args.konfigurasi)
    use_timezone(config.get("ZONA_WAKTU"))

    if args.tes_telegram:
        return 0 if test_telegram(config) else 1

    catalog = read_catalog()
    if not catalog:
        say("katalog kosong - tidak bisa menyusun laporan")
        return 3
    reasoner = Reasoner(config)

    say(f"siklus {args.siklus}, memeriksa {len(ALL_CONTROLS)} kontrol")
    checks = {kid: call_yoructl(kid, "periksa") for kid in ALL_CONTROLS}

    report = build_report(args.siklus, config, catalog, reasoner, checks,
                          read_previous_report() if args.siklus == "penjagaan" else None)
    say(f"skor {report['summary']['score']} "
        f"(lulus {report['summary']['passed']}/{report['summary']['total']}), "
        f"drift {len(report['drift'])}, "
        f"menunggu keputusan {len(report['pending_decisions'])}")

    decisions = {}
    if not args.tanpa_kirim:
        send_report(report, config)
        answer = fetch_decisions(config, report["server"]["name"])
        decisions = answer.get("decisions", {}) if isinstance(answer, dict) else {}
        record_ports(answer.get("port", []) if isinstance(answer, dict) else [])

    done = execute(report, decisions, dry_run=args.kering)
    if done:
        report = refresh(report, catalog, reasoner, done)
        say(f"skor sesudah dikerjakan: {report['summary']['score']}")

    save_report(report)
    if not args.tanpa_kirim:
        if done:
            send_report(report, config)
        notify_telegram(report, config)
    if args.keluar:
        Path(args.keluar).write_text(
            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")

    print(json.dumps(report["summary"], ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
