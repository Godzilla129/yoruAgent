# Konfigurasi Yoru
#
# Yang asli ada di /etc/yoru/yoru.conf, dibuat install.sh dengan pemilik
# root:yoru-agent dan izin 0640. Di dalamnya ada token bot dan token dashboard -
# agent perlu baca, pengguna lain di server itu tidak.
#
# Installer tidak akan menimpa berkas yang sudah ada.
#
# ---------------------------------------------------------------------
# CARA BACA - untuk Lane 3
# ---------------------------------------------------------------------
# Bentuknya KUNCI="nilai" satu per baris, # untuk komentar.
#
# Jangan pakai source atau eval. Nilai yang mengandung $(...) bakal
# dijalankan oleh proses yang lagi megang token. Baca sebagai teks:
#
#     def baca_konfigurasi(jalur="/etc/yoru/yoru.conf"):
#         konf = {}
#         with open(jalur) as f:
#             for baris in f:
#                 baris = baris.strip()
#                 if not baris or baris.startswith("#") or "=" not in baris:
#                     continue
#                 kunci, nilai = baris.split("=", 1)
#                 konf[kunci.strip()] = nilai.strip().strip('"')
#         return konf
#
# Nilai kosong = fitur mati, bukan konfigurasi salah. Yoru harus tetap jalan
# walau Telegram dan dashboard dua-duanya kosong: kontrol tetap dikerjakan,
# laporan tetap ditulis ke disk, cuma tidak ada yang dikabari. Jangan
# berhenti dengan error.


# ============================== IDENTITAS ==============================

# Nama yang muncul di dashboard dan bot. Kosong = pakai hostname. Berguna
# diisi kalau nama dari penyedia VPS tidak berarti apa-apa buat pemiliknya,
# misalnya "vps-84213".
NAMA_SERVER=""


# ============================ MODEL AI =================================
#
# TIDAK ADA di sini, dan itu disengaja.
#
# Yang memanggil model AI itu Hermes, bukan Yoru. Yoru cuma menyediakan
# katalog, dispatcher, dan laporan - dia tidak pernah bicara ke model sama
# sekali. Jadi kunci API dan nama model tinggal di konfigurasi Hermes, satu
# tempat saja.
#
# Kalau ditaruh di sini juga, ada dua tempat yang menyimpan rahasia yang
# sama: dua tempat yang bisa bocor, dan dua tempat yang bisa beda isinya
# tanpa ada yang sadar.


# ======================= TELEGRAM (opsional) ===========================
# Kosongkan kalau tidak dipakai.
#
# TELEGRAM_CHAT_ID boleh kosong walau tokennya diisi - Yoru nyari sendiri.
# Pemilik cukup kirim /start ke botnya. "Chat id" itu istilah kita, bukan
# istilah dia.

TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""


# ======================= DASHBOARD (opsional) ==========================
# Kosongkan kalau belum ada. Laporan tetap ditulis ke
# /var/lib/yoru/laporan-terakhir.json.
#
# Arahnya satu jalur: agent MENGIRIM laporan ke alamat ini, lalu MENGAMBIL
# keputusan pemilik dari alamat yang sama di siklus berikutnya. Dashboard
# tidak pernah menghubungi server.
#
# Karena itu server yang dijaga Yoru tidak perlu buka satu port pun untuk
# dashboard. Dan kalau dashboardnya jebol, penyerang paling jauh cuma bisa
# menyetujui kontrol yang sudah ada di katalog - dia tidak bisa menyuruh
# server melakukan hal baru. Jangan pernah membalik arah ini.
#
# Isi lengkap dengan http:// atau https://. Kalau dashboardnya satu mesin
# dengan agent: http://127.0.0.1:8080

DASHBOARD_URL=""
DASHBOARD_TOKEN=""


# ============================== PERILAKU ===============================

# Jam Siklus Penjagaan harian, format 24 jam, dipakai timer systemd. Pilih
# jam sepi. Jangan tepat di menit 00 - kalau semua server pakai angka bawaan
# yang sama, semuanya ngetuk dashboard di detik yang sama.
JAM_PENJAGAAN="03:17"

# Zona waktu untuk semua jam di laporan. Jam server biasanya UTC sementara
# pemiliknya baca waktu setempat. Lihat aturan nomor 3 di contract/report.md.
ZONA_WAKTU="Asia/Jakarta"

# Kontrol yang tidak boleh disentuh di server ini, dipisah koma. Kosong =
# semua boleh dipertimbangkan.
#
# Gunanya untuk keadaan yang cuma diketahui pemiliknya, misalnya kontrol yang
# bentrok dengan cara kerja panel tertentu.
#
# CATATAN: sampai yoructl 0.1.4, di sini tertulis bahwa server ber-aaPanel
# atau CyberPanel harus mengisi LEWATI_KONTROL="K05" karena K05 cuma membuka
# port 22. Itu sudah tidak berlaku. Sejak 0.1.5, K05 membaca port SSH dari
# sshd sendiri dan menolak menyala selama masih ada port terbuka yang belum
# dijawab pemilik - lihat PORT_DIIZINKAN di bawah. Melewati K05 berarti
# server itu tidak punya firewall sama sekali, jadi jangan dipakai kecuali
# memang terpaksa.
LEWATI_KONTROL=""

# Port yang boleh tetap terbuka dari internet selain port SSH, dipisah spasi.
#
# K05 menyalakan firewall tolak-semua. Port SSH dicari sendiri dari sshd,
# jadi tidak perlu ditulis di sini. Yang perlu ditulis: layanan lain yang
# memang harus bisa diakses orang - web, panel, dan sejenisnya.
#
# Yoru TIDAK menebak. Kalau ada port terbuka yang tidak ada di sini, K05
# menolak menyala dan menyebutkan portnya berikut nama prosesnya, supaya
# pemilik yang memutuskan. Mengizinkan otomatis berarti port yang terbuka
# TIDAK SENGAJA - justru yang mau ditutup - ikut diizinkan.
#
# Contoh isi:  PORT_DIIZINKAN="80 443 8888"
#              80/443 web, 8888 aaPanel
#
# Boleh juga dikosongkan di sini dan dijawab pemilik lewat dashboard atau
# Telegram; jawaban itu dicatat agent ke /var/lib/yoru/port-disetujui, satu
# port per baris. Dua-duanya dibaca. Yang ditulis di berkas ini lebih kuat
# karena agent tidak bisa menyuntingnya.
PORT_DIIZINKAN=""
